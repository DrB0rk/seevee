{
  "name": "@seevee/template-compiler",
  "version": "0.2.0",
  "private": true,
  "description": "Seevee source-template compiler — converts a versioned Astro template into an immutable, hashable artifact directory after a static safety scan, manifest validation, fixture renders, and layout diagnostics.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"lint skipped\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@seevee/schema": "workspace:*",
    "@seevee/template-sdk": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
