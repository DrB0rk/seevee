{
  "name": "@seevee/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./adapters/text": "./src/adapters/text.ts",
    "./adapters/markdown": "./src/adapters/markdown.ts",
    "./adapters/json": "./src/adapters/json.ts",
    "./adapters/html": "./src/adapters/html.ts",
    "./adapters/yaml": "./src/adapters/yaml.ts",
    "./adapters/pdf": "./src/adapters/pdf.ts",
    "./adapters/docx": "./src/adapters/docx.ts",
    "./adapters/url": "./src/adapters/url.ts",
    "./adapters/image": "./src/adapters/image.ts",
    "./ssrf": "./src/ssrf.ts",
    "./types": "./src/types.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"lint skipped\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@seevee/schema": "workspace:*",
    "js-yaml": "^4.3.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
