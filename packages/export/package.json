{
  "name": "@seevee/export",
  "version": "0.1.0",
  "private": true,
  "description": "Seevee PDF export pipeline — orchestrates renderer output, layout diagnostics, Playwright capture, and per-export metadata per DEVELOPMENT_PLAN.md §12.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"lint skipped\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@seevee/schema": "workspace:*",
    "@seevee/renderer": "workspace:*",
    "@seevee/template-sdk": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "playwright": "*"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
