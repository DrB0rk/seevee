{
  "name": "@seevee/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Seevee command-line interface — install once, run `seevee init` to scaffold a workspace.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "seevee": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "echo \"lint skipped\"",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@seevee/schema": "workspace:*",
    "@seevee/template-compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
