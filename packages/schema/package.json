    "test:unit": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "drift-check": "tsx scripts/drift-check.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  }
}