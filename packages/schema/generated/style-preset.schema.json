{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "seevee.style-preset"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "templateId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "templateVersionId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "color"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          }
        },
        "page": {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "enum": [
                "A4",
                "Letter",
                "Legal",
                "custom"
              ]
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape"
              ]
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "minimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "minimum": 0
            },
            "scale": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 4
            },
            "edges": {
              "type": "object",
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 0
                },
                "right": {
                  "type": "number",
                  "minimum": 0
                },
                "bottom": {
                  "type": "number",
                  "minimum": 0
                },
                "left": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "top",
                "right",
                "bottom",
                "left"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "preset",
            "orientation"
          ],
          "additionalProperties": false
        },
        "sectionOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "order": {
                "type": "integer"
              },
              "tokens": {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "number"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "color"
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "boolean"
                        },
                        "value": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "propertyNames": {
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "propertyNames": {
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "name",
        "templateId",
        "templateVersionId",
        "tokens",
        "page",
        "sectionOverrides"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "data"
  ],
  "additionalProperties": false,
  "$id": "https://seevee.dev/schema/v1/style-preset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
