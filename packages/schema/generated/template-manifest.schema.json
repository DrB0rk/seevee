{
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "seevee.template-manifest"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "templateId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "const": "astro"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "multiPage": {
          "type": "boolean"
        },
        "customPageSize": {
          "type": "boolean"
        },
        "comments": {
          "type": "boolean"
        },
        "twoColumn": {
          "type": "boolean"
        },
        "accessiblePdf": {
          "type": "boolean"
        }
      },
      "required": [
        "multiPage",
        "customPageSize",
        "comments",
        "twoColumn"
      ],
      "additionalProperties": false
    },
    "supportedCvSchema": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "supportedPresentationSchema": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0,
                "minimum": 0
              },
              "dashboardEditable": {
                "type": "boolean"
              },
              "affectsPagination": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default",
              "dashboardEditable"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "color"
              },
              "default": {
                "type": "string"
              },
              "dashboardEditable": {
                "type": "boolean"
              },
              "affectsPagination": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default",
              "dashboardEditable"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              },
              "dashboardEditable": {
                "type": "boolean"
              },
              "affectsPagination": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default",
              "dashboardEditable"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "enum"
              },
              "default": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "dashboardEditable": {
                "type": "boolean"
              },
              "affectsPagination": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default",
              "options",
              "dashboardEditable"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              },
              "dashboardEditable": {
                "type": "boolean"
              },
              "affectsPagination": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default",
              "dashboardEditable"
            ],
            "additionalProperties": false
          }
        ]
      },
      "propertyNames": {
        "minLength": 1
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "field",
              "node",
              "section",
              "collection",
              "custom"
            ]
          },
          "defaultToken": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "selector",
          "kind"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {}
    },
    "designIntent": {
      "type": "object",
      "properties": {
        "sector": {
          "type": "string"
        },
        "voice": {
          "type": "string",
          "enum": [
            "academic",
            "corporate",
            "creative",
            "technical",
            "executive",
            "minimal",
            "custom"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "templateId",
    "name",
    "version",
    "entry",
    "engine",
    "capabilities",
    "supportedCvSchema",
    "supportedPresentationSchema",
    "tokens",
    "bindings"
  ],
  "additionalProperties": false,
  "$id": "https://seevee.dev/schema/v1/template-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
