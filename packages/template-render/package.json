{
  "name": "@seevee/template-render",
  "version": "0.3.3",
  "private": true,
  "description": "Executes a real Astro source template to HTML through Astro's server-rendering container — the path that makes template-driven rendering real instead of stubbed.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./server": "./src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"lint skipped\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@seevee/schema": "workspace:*",
    "@seevee/template-sdk": "workspace:*",
    "astro": "^5.18.0",
    "vite": "^6.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}