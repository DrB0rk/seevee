{
  "kind": "seevee.template-manifest",
  "schemaVersion": "1.0.0",
  "id": "tpltwocolumn000000000000000001",
  "templateId": "two-column",
  "name": "Two-Column",
  "version": "1.0.0",
  "entry": "src/Resume.astro",
  "engine": "astro",
  "capabilities": {
    "multiPage": true,
    "customPageSize": false,
    "comments": true,
    "twoColumn": true
  },
  "supportedCvSchema": "1.0.0",
  "supportedPresentationSchema": "1.0.0",
  "tokens": {
    "accent-color": {
      "type": "color",
      "default": "#0f172a",
      "dashboardEditable": true,
      "affectsPagination": false
    },
    "font-family": {
      "type": "string",
      "default": "Inter, system-ui, sans-serif",
      "dashboardEditable": true,
      "affectsPagination": true
    },
    "base-font-size": {
      "type": "number",
      "default": 10.5,
      "min": 9,
      "max": 14,
      "step": 0.5,
      "dashboardEditable": true,
      "affectsPagination": true
    },
    "line-height": {
      "type": "number",
      "default": 1.35,
      "min": 1.0,
      "max": 2.0,
      "step": 0.05,
      "dashboardEditable": true,
      "affectsPagination": true
    },
    "sidebar-ratio": {
      "type": "number",
      "default": 0.34,
      "min": 0.2,
      "max": 0.5,
      "step": 0.01,
      "dashboardEditable": true,
      "affectsPagination": true
    },
    "column-gap": {
      "type": "number",
      "default": 5,
      "min": 2,
      "max": 12,
      "step": 0.5,
      "dashboardEditable": true,
      "affectsPagination": true
    }
  },
  "bindings": {
    "identity": {
      "id": "identity",
      "selector": "[data-seevee-identity]",
      "kind": "section",
      "description": "Identity (name + contact) header in the sidebar."
    },
    "sidebar-skills": {
      "id": "sidebar-skills",
      "selector": "[data-seevee-section=\"skills\"]",
      "kind": "collection",
      "description": "Skill groups rendered in the sidebar."
    },
    "sidebar-education": {
      "id": "sidebar-education",
      "selector": "[data-seevee-section=\"education\"]",
      "kind": "collection",
      "description": "Education items rendered in the sidebar."
    },
    "main-summary": {
      "id": "main-summary",
      "selector": "[data-seevee-section=\"summary\"]",
      "kind": "section",
      "description": "Summary block rendered at the top of the main column."
    },
    "main-experience": {
      "id": "main-experience",
      "selector": "[data-seevee-section=\"experience\"]",
      "kind": "collection",
      "description": "Experience items rendered in the main column."
    },
    "main-projects": {
      "id": "main-projects",
      "selector": "[data-seevee-section=\"projects\"]",
      "kind": "collection",
      "description": "Project items rendered in the main column."
    }
  },
  "extensions": {},
  "designIntent": {
    "sector": "general",
    "voice": "minimal",
    "constraints": ["two-column", "sidebar-skills-contact", "main-experience-education"]
  }
}