{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seevee.dev/schema/v1/workspace.schema.json",
  "title": "Seevee Workspace",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "data"
  ],
  "properties": {
    "kind": {
      "const": "seevee.workspace"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "name",
        "active",
        "resources",
        "sources",
        "policy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "$ref": "#/$defs/active"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "policy": {
      "type": "object",
      "required": [
        "allowAgentFactInference",
        "requireEvidenceForNumericClaims",
        "allowForceExportWithOverflow",
        "autoResolveDeterministicComments"
      ],
      "properties": {
        "allowAgentFactInference": {
          "type": "boolean"
        },
        "requireEvidenceForNumericClaims": {
          "type": "boolean"
        },
        "allowForceExportWithOverflow": {
          "type": "boolean"
        },
        "autoResolveDeterministicComments": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "active": {
      "type": "object",
      "required": [
        "cvId",
        "presentationId"
      ],
      "properties": {
        "cvId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "presentationId": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "cvs",
        "presentations",
        "provenance",
        "comments"
      ],
      "properties": {
        "cvs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cvResource"
          }
        },
        "presentations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/presentationResource"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fileResource"
          }
        },
        "comments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fileResource"
          }
        }
      },
      "additionalProperties": false
    },
    "cvResource": {
      "type": "object",
      "required": [
        "path",
        "name",
        "provenanceId",
        "commentsId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenanceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "commentsId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "defaultPresentationId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "presentationResource": {
      "type": "object",
      "required": [
        "path",
        "cvId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "cvId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "fileResource": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "additionalProperties": false
    }
  }
}
