{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seevee.dev/schema/v1/provenance.schema.json",
  "title": "Seevee Provenance Document",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "data"
  ],
  "properties": {
    "kind": {
      "const": "seevee.provenance"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "sources",
        "assertions"
      ],
      "properties": {
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/source"
          }
        },
        "assertions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/assertion"
          }
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "sourceType",
        "name",
        "contentHash",
        "ingestedAt",
        "metadata"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "ingestedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "id",
        "target",
        "evidence",
        "claimType",
        "confidence",
        "verifiedByUser"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/semanticRef"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "claimType": {
          "enum": [
            "explicit",
            "paraphrased",
            "inferred",
            "user-confirmed",
            "generated"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verifiedByUser": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "common.schema.json#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "sourceId",
        "locator"
      ],
      "properties": {
        "sourceId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "page"
          ],
          "properties": {
            "type": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "page",
            "quote"
          ],
          "properties": {
            "type": {
              "const": "page-text"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "start",
            "end"
          ],
          "properties": {
            "type": {
              "const": "text-range"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "quote": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "pointer"
          ],
          "properties": {
            "type": {
              "const": "json-pointer"
            },
            "pointer": {
              "$ref": "common.schema.json#/$defs/jsonPointer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "fragment": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "lineStart"
          ],
          "properties": {
            "type": {
              "const": "file-lines"
            },
            "lineStart": {
              "type": "integer",
              "minimum": 1
            },
            "lineEnd": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
