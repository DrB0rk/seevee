---
/** Fixed editor shell. CV data and edits come from the workspace APIs. */
import '../styles/dashboard.css';
import AgentSidebar from '../components/AgentSidebar.astro';
import { Building2, Bot, FileSliders, FileText, FolderOpen, Info, Maximize2, MessageSquarePlus, Moon, MonitorCog, Plus, RotateCcw, Settings2, Sun, Upload, UsersRound, X, ZoomIn, ZoomOut } from 'lucide-react';

interface Props {
  workspaceName: string;
  workspaceId: string;
  serverVersion: string;
  pid: number;
  startedAt: string;
}

const { workspaceName, workspaceId, serverVersion } = Astro.props as Props;
---

<div class="studio" id="studio" data-workspace-id={workspaceId}>
  <header class="topbar">
    <a class="brand" href="/" aria-label="Seevee Studio home">
      <img class="brand-mark" src="/seevee-logo.svg" alt="" />
      <span class="brand-name">seevee</span>
    </a>
    <span class="topbar-divider" aria-hidden="true"></span>
    <div class="workspace-label">
      <span class="eyebrow">WORKSPACE</span>
      <strong id="workspace-name">{workspaceName}</strong>
    </div>
    <label class="cv-select-wrap" for="cv-picker">
      <span class="eyebrow">DOCUMENT</span>
      <select id="cv-picker" aria-label="Choose a CV" data-select-variant="document" disabled>
        <option>Loading CVs…</option>
      </select>
    </label>
    <div class="save-state" id="save-state" data-state="loading" role="status" aria-live="polite">
      <span class="save-dot" aria-hidden="true"></span>
      <span id="save-label">Connecting to workspace</span>
    </div>
    <div class="top-actions">
      <button class="icon-button theme-toggle" id="theme-toggle" type="button" title="Switch between light and dark" aria-label="Switch to light theme" aria-pressed="false"><Sun className="icon theme-icon-light" aria-hidden="true" /><Moon className="icon theme-icon-dark" aria-hidden="true" /></button>
      <button class="button button-subtle settings-trigger" id="settings-toggle" type="button" aria-haspopup="dialog" aria-controls="settings-popover" aria-expanded="false"><Settings2 className="icon" aria-hidden="true" />Settings</button>
      <button class="button button-accent" id="export-pdf" type="button" title="Print or save this CV as a PDF"><FileText className="icon" aria-hidden="true" />Export PDF</button>
      <span class="version-label">v{serverVersion}</span>
    </div>
  </header>

  <section class="settings-popover" id="settings-popover" role="dialog" aria-modal="true" aria-labelledby="settings-title" tabindex="-1" hidden>
    <header class="settings-popover-heading">
      <div><span class="eyebrow">PREFERENCES · <span id="settings-context-name">{workspaceName}</span></span><h2 id="settings-title">Settings</h2></div>
      <button class="icon-button" id="settings-close" type="button" aria-label="Close settings"><X className="icon" aria-hidden="true" /></button>
    </header>
    <div class="settings-popover-layout">
      <nav class="settings-nav" aria-label="Settings sections">
        <div class="settings-nav-group">
          <span class="settings-nav-label">Workspace</span>
          <button type="button" data-settings-section="workspace" aria-current="page"><Building2 className="icon" aria-hidden="true" />Workspace</button>
          <button type="button" data-settings-section="dashboard"><MonitorCog className="icon" aria-hidden="true" />Dashboard</button>
        </div>
        <div class="settings-nav-group">
          <span class="settings-nav-label">Agent</span>
          <button type="button" data-settings-section="agents"><Bot className="icon" aria-hidden="true" />Connections</button>
          <button type="button" data-settings-section="agent"><UsersRound className="icon" aria-hidden="true" />Behavior</button>
        </div>
        <div class="settings-nav-group">
          <span class="settings-nav-label">Document</span>
          <button type="button" data-settings-section="document"><FileSliders className="icon" aria-hidden="true" />Page setup</button>
          <button type="button" data-settings-section="references"><FolderOpen className="icon" aria-hidden="true" />References</button>
          <button type="button" data-settings-section="comments"><MessageSquarePlus className="icon" aria-hidden="true" />Comments</button>
        </div>
        <div class="settings-nav-group">
          <span class="settings-nav-label">About</span>
          <button type="button" data-settings-section="about"><Info className="icon" aria-hidden="true" />About Seevee</button>
        </div>
      </nav>
      <div class="settings-panels">
        <section class="settings-view" data-settings-view="workspace">
          <h3>Workspace</h3><p class="settings-description">Manage the name and identity for this local workspace.</p>
          <div class="settings-identity-card"><span class="settings-identity-mark"><Building2 className="icon" aria-hidden="true" /></span><div><strong>{workspaceName}</strong><small>Stored locally in <code>seevee.json</code></small></div></div>
          <label class="settings-field"><span>Workspace name</span><input id="workspace-name-input" type="text" maxlength="120" value={workspaceName} disabled></label>
          <div class="settings-readonly"><span>Workspace ID</span><code id="settings-workspace-id">{workspaceId}</code></div>
        </section>
        <section class="settings-view" data-settings-view="agents" hidden>
          <h3>Agents</h3>
          <p class="settings-description">Select a locally installed agent, start or resume its session, and configure the active model and permission mode.</p>
          <div class="agent-settings-grid">
            <label class="settings-field"><span>Agent</span><select id="agent-provider-select" disabled><option>Detecting agents…</option></select></label>
            <div class="settings-readonly"><span>Installation</span><strong id="agent-provider-status">Detecting local agents…</strong></div>
            <label class="settings-field"><span>Model</span><select id="agent-model-select" disabled><option value="">Loading models…</option></select></label>
            <label class="settings-field"><span>Permission mode</span><select id="agent-permission-select" disabled><option value="">Loading permissions…</option></select></label>
          </div>
          <div class="agent-settings-actions">
            <button class="button button-primary" id="agent-session-start" type="button" disabled>Start selected agent</button>
            <button class="button button-subtle" id="agent-session-resume" type="button" disabled>Resume latest saved session</button>
            <button class="button button-subtle" id="agent-session-apply" type="button" disabled>Apply to active session</button>
          </div>
          <div class="settings-readonly agent-active-session"><span>Active chat session</span><strong id="agent-active-session">None</strong></div>
          <div class="agent-saved-session-settings">
            <h4>Saved sessions</h4>
            <div id="agent-saved-session-list"><p class="settings-description">No saved sessions.</p></div>
          </div>
          <p class="settings-status" id="agent-settings-status" role="status" aria-live="polite">Agent settings are ready.</p>
        </section>
        <section class="settings-view" data-settings-view="agent" hidden>
          <h3>Agent behavior</h3><p class="settings-description">These policies are written to <code>seevee.json</code> for workspace agents to follow.</p>
          <label class="settings-toggle"><span><strong>Allow factual inference</strong><small>Let agents infer facts when source material is incomplete.</small></span><input type="checkbox" data-workspace-policy="allowAgentFactInference" disabled></label>
          <label class="settings-toggle"><span><strong>Require evidence for numbers</strong><small>Ask agents to support numeric claims with source evidence.</small></span><input type="checkbox" data-workspace-policy="requireEvidenceForNumericClaims" disabled></label>
          <label class="settings-toggle"><span><strong>Allow export with overflow</strong><small>Allow PDF export when content extends beyond the selected page size.</small></span><input type="checkbox" data-workspace-policy="allowForceExportWithOverflow" disabled></label>
          <label class="settings-toggle"><span><strong>Auto-resolve deterministic comments</strong><small>Resolve comments automatically when a matching change is applied.</small></span><input type="checkbox" data-workspace-policy="autoResolveDeterministicComments" disabled></label>
        </section>
        <section class="settings-view" data-settings-view="dashboard" hidden>
          <h3>Dashboard</h3><p class="settings-description">These display preferences are saved in this browser.</p>
          <label class="settings-field"><span>Document zoom <output id="settings-zoom-value">100%</output></span><input id="settings-zoom" type="range" min="40" max="200" step="1" value="100"></label>
          <label class="settings-field"><span>Agent chat width <output id="settings-agent-width-value">460 px</output></span><input id="settings-agent-width" type="range" min="320" max="720" step="10" value="460"></label>
          <label class="settings-field"><span>Content sidebar width <output id="settings-editor-width-value">360 px</output></span><input id="settings-editor-width" type="range" min="280" max="720" step="10" value="360"></label>
          <button class="button button-subtle settings-reset" id="settings-reset-dashboard" type="button"><RotateCcw className="icon" aria-hidden="true" />Reset dashboard preferences</button>
        </section>
        <section class="settings-view" data-settings-view="document" hidden>
          <h3>Document</h3><p class="settings-description">Paper size, margins, typography, and accent color are saved with the active presentation.</p>
          <button class="button button-subtle" type="button" data-open-settings-target="document-settings"><FileSliders className="icon" aria-hidden="true" />Open page setup</button>
        </section>
        <section class="settings-view" data-settings-view="references" hidden>
          <h3>Reference files</h3><p class="settings-description">Upload source CVs, profile photos, certificates, and other material agents can use.</p>
          <button class="button button-subtle" type="button" data-open-settings-target="asset-library"><FolderOpen className="icon" aria-hidden="true" />Open reference files</button>
        </section>
        <section class="settings-view" data-settings-view="comments" hidden>
          <h3>Comments</h3><p class="settings-description">Review the saved comments for the active CV. Comments include their page location and selected content.</p>
          <button class="button button-subtle" type="button" data-open-settings-target="dashboard-comments"><MessageSquarePlus className="icon" aria-hidden="true" />Show CV comments</button>
        </section>
        <section class="settings-view" data-settings-view="about" hidden>
          <h3>About Seevee</h3><p class="settings-description">Local CV workspace and editor.</p>
          <dl class="settings-about"><div><dt>Version</dt><dd>v{serverVersion}</dd></div><div><dt>Workspace</dt><dd id="settings-about-workspace-name">{workspaceName}</dd></div><div><dt>Workspace ID</dt><dd><code>{workspaceId}</code></dd></div></dl>
        </section>
      </div>
    </div>
    <footer class="settings-popover-footer"><span class="settings-save-state" id="workspace-settings-status" role="status" aria-live="polite">Workspace settings are ready.</span></footer>
  </section>

  <aside class="agent-panel" aria-label="Agent control">
    <AgentSidebar workspaceId={workspaceId} />
  </aside>
  <div class="agent-resize" id="agent-resize" role="separator" aria-orientation="vertical" aria-label="Resize agent chat" aria-valuemin="320" aria-valuemax="720" aria-valuenow="460" tabindex="0" title="Drag to resize the agent chat"></div>

  <main class="work-area" aria-label="CV editor">
    <div class="canvas-bar">
      <div class="canvas-title">
        <span class="canvas-kicker">LIVE PREVIEW</span>
        <span id="preview-name">Untitled CV</span>
      </div>
      <div class="document-mode" role="group" aria-label="Document mode">
        <button class="mode-button" type="button" data-document-mode="preview" aria-pressed="true">Preview</button>
        <button class="mode-button" type="button" data-document-mode="edit" aria-pressed="false">Edit</button>
      </div>
    </div>
    <div class="pasteboard" id="pasteboard">
      <div class="paper-stack" id="cv-paper" aria-label="CV preview">
        <article class="paper" data-page-number="1" aria-label="Page 1"><p class="paper-loading">Loading your CV…</p></article>
      </div>
    </div>
    <div class="tool-rail" id="canvas-tool-rail" role="toolbar" aria-label="CV canvas controls" aria-orientation="vertical">
      <button class="rail-button rail-comment" type="button" id="place-comment" aria-pressed="false" title="Place a comment on the CV" aria-label="Place a comment on the CV"><MessageSquarePlus className="icon" aria-hidden="true" /></button>
      <span class="rail-divider" aria-hidden="true"></span>
      <button class="rail-button" type="button" data-zoom="+" title="Zoom in" aria-label="Zoom in"><ZoomIn className="icon" aria-hidden="true" /></button>
      <button class="rail-zoom" type="button" id="zoom-readout" title="Reset zoom to 100 percent" aria-label="Current zoom 100 percent. Reset zoom to 100 percent">100%</button>
      <button class="rail-button" type="button" data-zoom="-" title="Zoom out" aria-label="Zoom out"><ZoomOut className="icon" aria-hidden="true" /></button>
      <button class="rail-button rail-fit" type="button" id="fit-page" title="Fit page to canvas width" aria-label="Fit page to canvas width"><Maximize2 className="icon" aria-hidden="true" /><span>Fit</span></button>
    </div>
  </main>

  <div class="editor-resize" id="editor-resize" role="separator" aria-orientation="vertical" aria-label="Resize right sidebar" aria-valuemin="280" aria-valuemax="720" aria-valuenow="360" tabindex="0" title="Drag to resize the right sidebar"></div>
  <aside class="editor-panel" aria-label="Edit CV content">
    <div class="editor-section-jump-heading">
      <span>Sections</span>
      <button type="button" class="icon-button" id="add-experience" aria-label="Add experience" title="Add experience"><Plus className="icon" aria-hidden="true" /></button>
    </div>
    <nav class="section-list editor-section-list" id="section-list" aria-label="CV sections"></nav>
    <div class="editor-content" id="editor-content">
      <p class="quiet-message">Your fields will appear here.</p>
    </div>
    <section class="dashboard-comments" aria-label="Comments for this CV">
      <h3>Comments <span id="comment-count">0</span></h3>
      <div id="comment-list"><p class="quiet-message">No comments yet. Choose “Place comment” to pin one to the page.</p></div>
    </section>
    <details class="editor-tools" id="editor-tools">
      <summary>References &amp; document settings</summary>
      <div class="editor-tools-body">
        <details class="asset-library" id="asset-library">
          <summary>Reference files <span class="asset-count" id="asset-count">0</span></summary>
          <div class="asset-body">
            <p class="asset-intro">Add a profile photo, existing CV, or other material for your agent to use.</p>
            <label class="settings-field"><span>File purpose</span><select id="asset-purpose"><option value="profile-photo">Profile photo</option><option value="reference-cv">Reference CV</option><option value="certificate">Certificate</option><option value="portfolio">Portfolio or work sample</option><option value="other">Other reference</option></select></label>
            <button class="asset-dropzone" id="asset-dropzone" type="button" aria-label="Choose files or drop files to upload">
              <Upload className="icon upload-icon" aria-hidden="true" /><strong>Drop files here</strong><small>or click to browse · PDF, images, DOCX, and text · up to 20 MB each</small>
            </button>
            <input id="asset-input" class="visually-hidden" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.webp,.gif,.docx,.txt,.md,.rtf,.odt,.json,.csv">
            <ul class="asset-list" id="asset-list" aria-label="Uploaded reference files"></ul>
            <p class="asset-status" id="asset-status" role="status" aria-live="polite">Files are saved in this workspace for the agent.</p>
          </div>
        </details>
        <details class="document-settings" id="document-settings">
          <summary>Document settings</summary>
          <div class="settings-body">
            <label class="settings-field"><span>Paper size</span><select id="setting-page-preset"><option value="A4">A4</option><option value="Letter">US Letter</option><option value="Legal">US Legal</option><option value="custom">Custom</option></select></label>
            <label class="settings-field"><span>Orientation</span><select id="setting-orientation"><option value="portrait">Portrait</option><option value="landscape">Landscape</option></select></label>
            <div class="settings-field" id="custom-page-dimensions" hidden><span>Custom page size (mm)</span><div class="settings-pair"><label>Width<input id="setting-page-width" type="number" min="80" max="500" step="1" value="210"></label><label>Height<input id="setting-page-height" type="number" min="100" max="600" step="1" value="297"></label></div></div>
            <fieldset class="settings-field settings-margins"><legend>Margins (mm)</legend><div class="settings-grid"><label>Top<input data-page-margin="top" type="number" min="0" max="60" step="1" value="12"></label><label>Right<input data-page-margin="right" type="number" min="0" max="60" step="1" value="12"></label><label>Bottom<input data-page-margin="bottom" type="number" min="0" max="60" step="1" value="12"></label><label>Left<input data-page-margin="left" type="number" min="0" max="60" step="1" value="12"></label></div></fieldset>
            <label class="settings-field"><span>Font</span><select id="setting-font-family"><option value="Inter, system-ui, sans-serif">Inter</option><option value="Arial, Helvetica, sans-serif">Arial</option><option value="Georgia, 'Times New Roman', serif">Georgia</option></select></label>
            <div class="settings-pair settings-number-pair"><label>Font size (pt)<input id="setting-font-size" type="number" min="9" max="14" step="0.5" value="11"></label><label>Line height<input id="setting-line-height" type="number" min="1" max="2" step="0.05" value="1.45"></label></div>
            <label class="settings-field settings-color"><span>Accent color</span><input id="setting-accent-color" type="color" value="#1f2937"></label>
            <p class="settings-status" id="settings-status" role="status" aria-live="polite">Saved with this document</p>
          </div>
        </details>
      </div>
    </details>
  </aside>

  <dialog class="comment-dialog" id="comment-dialog" aria-labelledby="comment-title">
    <form id="comment-form">
      <h2 id="comment-title">Leave a comment</h2>
      <p id="comment-placement-label">Choose a point on the page.</p>
      <label class="field" for="comment-body"><span>What should the agent change?</span><textarea id="comment-body" name="body" rows="5" required></textarea></label>
      <div class="comment-dialog-actions"><button type="button" class="button button-subtle" id="comment-cancel">Cancel</button><button type="submit" class="button button-primary" id="comment-save">Save comment</button></div>
    </form>
  </dialog>
  <div class="editor-context-menu" id="editor-context-menu" role="menu" aria-label="CV actions" hidden></div>
</div>

<script>
  import { gsap } from 'gsap';

  const selectIcon = '<svg class="icon select-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>';
  const documentSelectIcon = '<svg class="icon document-select-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6M8 13h8M8 17h8" /></svg>';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let selectorSequence = 0;

  function enhanceSelect(select: HTMLSelectElement): void {
    if (select.dataset['customized'] === 'true' || select.closest('.agent-chat')) return;
    select.dataset['customized'] = 'true';
    const parent = select.parentElement;
    const label = select.getAttribute('aria-label')
      ?? parent?.querySelector<HTMLElement>(':scope > span')?.textContent?.trim()
      ?? parent?.textContent?.trim()
      ?? 'Choose an option';
    const id = `seevee-select-${++selectorSequence}`;
    const shell = document.createElement('span');
    shell.className = 'select-control';
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'select-trigger';
    trigger.setAttribute('role', 'combobox');
    trigger.setAttribute('aria-haspopup', 'listbox');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', label);
    trigger.setAttribute('aria-controls', `${id}-listbox`);
    if (select.dataset['selectVariant'] === 'document') {
      trigger.classList.add('document-select-trigger');
      trigger.insertAdjacentHTML('beforeend', documentSelectIcon);
      shell.dataset['variant'] = 'document';
    }
    const value = document.createElement('span');
    value.className = 'select-value';
    trigger.append(value);
    trigger.insertAdjacentHTML('beforeend', selectIcon);

    const listbox = document.createElement('span');
    listbox.className = 'select-listbox';
    listbox.id = `${id}-listbox`;
    listbox.setAttribute('role', 'listbox');
    listbox.setAttribute('aria-label', label);
    listbox.hidden = true;
    select.before(shell);
    shell.append(trigger, listbox, select);
    select.classList.add('select-native-hidden');
    select.tabIndex = -1;
    select.setAttribute('aria-hidden', 'true');

    let activeIndex = Math.max(0, Array.from(select.options).findIndex((option) => option.value === select.value));
    let typeahead = '';
    let typeaheadTimer = 0;
    const usableOptions = (): HTMLOptionElement[] => Array.from(select.options).filter((option) => !option.disabled && !option.parentElement?.matches('optgroup[disabled]'));
    const sync = (): void => {
      const selected = select.selectedOptions.item(0);
      value.textContent = selected?.label ?? 'Choose an option';
      trigger.disabled = select.disabled;
      trigger.setAttribute('aria-label', `${label}: ${selected?.label ?? 'Choose an option'}`);
      listbox.replaceChildren();
      Array.from(select.options).forEach((option, index) => {
        const row = document.createElement('span');
        row.className = 'select-option';
        row.id = `${id}-option-${index}`;
        row.setAttribute('role', 'option');
        row.setAttribute('aria-selected', String(option.selected));
        row.setAttribute('aria-disabled', String(option.disabled));
        row.textContent = option.label;
        if (index === activeIndex) row.dataset['active'] = 'true';
        if (option.selected) {
          row.dataset['selected'] = 'true';
          row.insertAdjacentHTML('beforeend', '<svg class="icon select-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>');
        }
        if (option.disabled) row.dataset['disabled'] = 'true';
        listbox.append(row);
      });
      const active = select.options.item(activeIndex);
      if (active !== null) trigger.setAttribute('aria-activedescendant', `${id}-option-${activeIndex}`);
      else trigger.removeAttribute('aria-activedescendant');
    };
    const close = (returnFocus = false): void => {
      if (listbox.hidden) return;
      shell.dataset['open'] = 'false';
      trigger.setAttribute('aria-expanded', 'false');
      window.removeEventListener('resize', placeListbox);
      document.removeEventListener('scroll', placeListbox, true);
      if (reducedMotion.matches) {
        listbox.hidden = true;
        listbox.removeAttribute('data-floating');
        listbox.style.cssText = '';
        shell.insertBefore(listbox, select);
      }
      else {
        gsap.killTweensOf(listbox);
        gsap.to(listbox, {
          autoAlpha: 0,
          y: -3,
          duration: 0.11,
          ease: 'power1.in',
          onComplete: () => {
            if (shell.dataset['open'] === 'true') return;
            listbox.hidden = true;
            listbox.removeAttribute('data-floating');
            shell.insertBefore(listbox, select);
            gsap.set(listbox, { clearProps: 'all' });
          },
        });
      }
      if (returnFocus) trigger.focus();
    };
    const placeListbox = (): void => {
      const rect = trigger.getBoundingClientRect();
      const viewportPadding = 8;
      const gap = 6;
      const maxHeight = Math.max(100, Math.min(280, window.innerHeight - viewportPadding * 2));
      const minWidth = Number.parseFloat(getComputedStyle(listbox).minWidth) || 0;
      const width = Math.min(window.innerWidth - viewportPadding * 2, Math.max(rect.width, minWidth));
      const left = Math.max(viewportPadding, Math.min(rect.left, window.innerWidth - width - viewportPadding));
      listbox.style.position = 'fixed';
      listbox.style.left = `${Math.round(left)}px`;
      listbox.style.right = 'auto';
      listbox.style.top = '0px';
      listbox.style.bottom = 'auto';
      listbox.style.width = `${Math.round(width)}px`;
      listbox.style.maxHeight = `${Math.round(maxHeight)}px`;
      const menuHeight = Math.min(listbox.scrollHeight, maxHeight);
      const spaceBelow = window.innerHeight - rect.bottom - gap - viewportPadding;
      const spaceAbove = rect.top - gap - viewportPadding;
      const placeAbove = spaceBelow < Math.min(menuHeight, 180) && spaceAbove > spaceBelow;
      const top = placeAbove ? rect.top - gap - menuHeight : rect.bottom + gap;
      listbox.style.top = `${Math.round(Math.max(viewportPadding, Math.min(top, window.innerHeight - menuHeight - viewportPadding)))}px`;
      listbox.dataset['placement'] = placeAbove ? 'top' : 'bottom';
    };
    const open = (): void => {
      if (trigger.disabled) return;
      document.querySelectorAll<HTMLElement>('.select-control[data-open="true"]').forEach((other) => {
        if (other !== shell) other.querySelector<HTMLButtonElement>('.select-trigger')?.dispatchEvent(new Event('seevee-select-close'));
      });
      activeIndex = Math.max(0, Array.from(select.options).findIndex((option) => option.value === select.value));
      sync();
      listbox.hidden = false;
      document.body.append(listbox);
      listbox.dataset['floating'] = 'true';
      placeListbox();
      window.addEventListener('resize', placeListbox);
      document.addEventListener('scroll', placeListbox, true);
      trigger.setAttribute('aria-expanded', 'true');
      shell.dataset['open'] = 'true';
      if (!reducedMotion.matches) {
        gsap.killTweensOf(listbox);
        gsap.fromTo(listbox, { autoAlpha: 0, y: -4, scale: 0.99 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.15, ease: 'power2.out', clearProps: 'transform' });
      }
    };
    const choose = (option: HTMLOptionElement): void => {
      if (option.disabled) return;
      select.value = option.value;
      select.dispatchEvent(new Event('input', { bubbles: true }));
      select.dispatchEvent(new Event('change', { bubbles: true }));
      sync();
      shell.dataset['open'] = 'false';
      close(true);
    };
    const moveActive = (direction: number): void => {
      const options = usableOptions();
      if (options.length === 0) return;
      const current = options.findIndex((option) => option.index === activeIndex);
      const next = (current + direction + options.length) % options.length;
      activeIndex = options[next]?.index ?? 0;
      sync();
      listbox.querySelector(`#${id}-option-${activeIndex}`)?.scrollIntoView({ block: 'nearest' });
    };

    trigger.addEventListener('click', () => listbox.hidden ? open() : close());
    trigger.addEventListener('seevee-select-close', () => close());
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (listbox.hidden) open();
        else moveActive(event.key === 'ArrowDown' ? 1 : -1);
      } else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        if (listbox.hidden) open();
        else {
          const option = select.options.item(activeIndex);
          if (option) choose(option);
        }
      } else if (event.key === 'Escape' && !listbox.hidden) {
        event.preventDefault();
        shell.dataset['open'] = 'false';
        close();
      } else if (event.key === 'Home' && !listbox.hidden) {
        event.preventDefault();
        activeIndex = usableOptions()[0]?.index ?? 0;
        sync();
      } else if (event.key === 'End' && !listbox.hidden) {
        event.preventDefault();
        activeIndex = usableOptions().at(-1)?.index ?? 0;
        sync();
      } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
        typeahead += event.key.toLocaleLowerCase();
        window.clearTimeout(typeaheadTimer);
        typeaheadTimer = window.setTimeout(() => { typeahead = ''; }, 600);
        const match = usableOptions().find((option) => option.label.toLocaleLowerCase().startsWith(typeahead));
        if (match) {
          activeIndex = match.index;
          if (listbox.hidden) open();
          sync();
        }
      }
    });
    listbox.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[role="option"]') : null;
      const index = target ? Number(target.id.slice(`${id}-option-`.length)) : Number.NaN;
      const option = Number.isInteger(index) ? select.options.item(index) : null;
      if (option) choose(option);
    });
    select.addEventListener('change', sync);
    new MutationObserver(sync).observe(select, { childList: true, subtree: true, attributes: true });
    shell.addEventListener('pointerdown', (event) => event.stopPropagation());
    document.addEventListener('pointerdown', (event) => {
      if (!shell.contains(event.target as Node) && !listbox.contains(event.target as Node)) {
        shell.dataset['open'] = 'false';
        close();
      }
    });
    sync();
  }

  document.querySelectorAll<HTMLSelectElement>('#studio select').forEach(enhanceSelect);
  const selectObserver = new MutationObserver((records) => {
    records.forEach((record) => record.addedNodes.forEach((node) => {
      if (!(node instanceof Element)) return;
      if (node instanceof HTMLSelectElement) enhanceSelect(node);
      node.querySelectorAll<HTMLSelectElement>('select').forEach(enhanceSelect);
    }));
  });
  const studio = document.querySelector('#studio');
  if (studio) selectObserver.observe(studio, { childList: true, subtree: true });
</script>

<script>
  // Theme runs before first paint so a light-mode user never sees a dark flash.
  // The whole dashboard reads semantic tokens, so switching is one attribute.
  type Theme = 'light' | 'dark';
  const THEME_KEY = 'seevee.theme';
  const media = window.matchMedia('(prefers-color-scheme: light)');
  const readStoredTheme = (): Theme | null => {
    try {
      const value = localStorage.getItem(THEME_KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  };
  const applyTheme = (theme: Theme): void => {
    const root = document.documentElement;
    root.dataset['theme'] = theme;
    root.style.colorScheme = theme;
    const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
    if (toggle === null) return;
    const next: Theme = theme === 'dark' ? 'light' : 'dark';
    toggle.setAttribute('aria-pressed', String(theme === 'light'));
    toggle.setAttribute('aria-label', `Switch to ${next} theme`);
    toggle.title = `Switch to ${next} theme`;
  };
  const currentTheme = (): Theme => (document.documentElement.dataset['theme'] === 'light' ? 'light' : 'dark');
  const syncTheme = (): void => applyTheme(readStoredTheme() ?? (media.matches ? 'light' : 'dark'));
  // Runs first, before paint, so a light-mode user never sees a dark flash.
  syncTheme();
  // The button is only in the DOM once the body has parsed; re-apply so its
  // label and pressed state match the theme already on the root.
  document.addEventListener('DOMContentLoaded', () => {
    applyTheme(currentTheme());
    document.querySelector<HTMLButtonElement>('#theme-toggle')?.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'light' ? 'dark' : 'light';
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch {
        // A blocked store must not stop the switch.
      }
      applyTheme(next);
    });
  });
  // Follow the OS only while the user has not chosen for themselves.
  media.addEventListener('change', (event) => {
    if (readStoredTheme() === null) applyTheme(event.matches ? 'light' : 'dark');
  });
</script>

<script>
  import { gsap } from 'gsap';

  type CvDoc = {
    id: string;
    revision: number;
    updatedAt: string;
    data: {
      locale: string;
      identity: {
        id: string;
        name: { display: string };
        headline?: string;
        summary?: string;
        contact: Array<{ kind: string; value: string; primary?: boolean }>;
      };
      sectionOrder: string[];
      sections: Record<string, { id: string; type: string; title: string; visible: boolean; nodeOrder?: string[] }>;
      entities: {
        custom?: Record<string, { id: string; type: 'customEntity'; label: string; data: Record<string, unknown> }>;
        experience?: Record<string, {
          id: string; type: 'experience';
          organization: { name: string };
          role: { title: string };
          period: { start: { precision: string; year: number }; end?: { precision: string; year: number }; ongoing?: boolean };
          summary?: string | null;
          bulletOrder: string[];
          bullets: Record<string, { id: string; text: string }>;
        }>;
        skills?: Record<string, { id: string; type: 'skill'; name: string; category?: string | null; keywords: string[] }>;
        education?: Record<string, { id: string; institution: { name: string }; program: { name: string; degree?: string | null }; period: { start: { precision: 'year'; year: number }; end?: { precision: 'year'; year: number }; ongoing?: boolean }; details: string[] }>;
        projects?: Record<string, { id: string; type: 'project'; name: string; summary?: string | null; period?: { start: { precision: string; year: number }; end?: { precision: string; year: number }; ongoing?: boolean } | null; linkRefs: string[]; technologyRefs: string[]; role?: { id: string; type: 'role'; title: string }; bulletOrder?: string[]; bullets?: Record<string, { id: string; text: string }> }>;
      };
    };
  };

  type CvListItem = { ok: true; cv: { id: string; name: string; headline: string | null; revision: number } } | { ok: false; path: string; reason: string };
  type WorkspaceAsset = { id: string; name: string; relativePath: string; purpose: string; contentType: string; size: number; uploadedAt: string };
  type Placement = { page: number; x: number; y: number; element: string; contextText?: string; fieldPath?: string; nodeId?: string; nodeType?: string; pointer?: string; sectionId?: string };
  type StoredThread = { id: string; category?: string; priority?: string; status?: string; target: { selectors: Array<Record<string, unknown>>; extensions?: Record<string, unknown> }; messageOrder: string[]; messages: Record<string, { body: string; createdAt: string; author?: { display?: string } }> };
  type CommentsDoc = { revision: number; data: { threadOrder: string[]; threads: Record<string, StoredThread> } };
  type AgentProviderId = 'claude-code' | 'codex' | 'omp';
  type AgentProviderSetting = { id: AgentProviderId; label: string; version: string | null; status: string; ready: boolean; message: string | null; capabilities: Record<string, boolean> };
  type AgentSelectOption = { id: string; label: string; description: string | null };
  type AgentSessionConfiguration = { model: string | null; permissionMode: string; models: AgentSelectOption[]; permissions: AgentSelectOption[] };
  type AgentSessionSetting = { id: string; provider: AgentProviderId; externalSessionId: string | null; title: string; state: string; model: string | null; capabilities: Record<string, boolean> };
  type SavedAgentSetting = { id: string; provider: AgentProviderId; externalSessionId: string; title: string; state: string; model: string | null; createdAt: string; lastActivityAt: string };
  type AgentSettingsSnapshot = { providers: AgentProviderSetting[]; sessions: AgentSessionSetting[]; events: unknown[] };
  type AgentSettingsResponse = { ok: boolean; snapshot: AgentSettingsSnapshot; savedSessions: SavedAgentSetting[] };

  const studio = document.querySelector<HTMLElement>('#studio')!;
  const agentResize = document.querySelector<HTMLElement>('#agent-resize')!;
  const editorResize = document.querySelector<HTMLElement>('#editor-resize')!;
  const agentWidthStorageKey = 'seevee.dashboard.agent-width';
  const editorWidthStorageKey = 'seevee.dashboard.editor-width';
  const narrowLayout = window.matchMedia('(max-width: 982px)');
  const minAgentWidth = 320;
  const minEditorWidth = 280;
  const defaultAgentWidth = window.innerWidth < 1360 ? 360 : 460;
  const defaultEditorWidth = window.innerWidth < 1360 ? 320 : 360;
  let agentWidth = defaultAgentWidth;
  let editorWidth = defaultEditorWidth;
  try {
    const savedAgentWidth = Number(localStorage.getItem(agentWidthStorageKey));
    const savedEditorWidth = Number(localStorage.getItem(editorWidthStorageKey));
    if (Number.isFinite(savedAgentWidth) && savedAgentWidth >= minAgentWidth) agentWidth = savedAgentWidth;
    if (Number.isFinite(savedEditorWidth) && savedEditorWidth >= minEditorWidth) editorWidth = savedEditorWidth;
  } catch { /* Keep default widths when browser storage is unavailable. */ }

  function setAgentWidth(width: number, persist = true): void {
    const workMinWidth = window.matchMedia('(max-width: 1120px)').matches ? 330 : 380;
    const maxWidth = Math.max(minAgentWidth, Math.min(720, studio.clientWidth - minEditorWidth - workMinWidth - 8));
    agentWidth = Math.max(minAgentWidth, Math.min(maxWidth, width));
    studio.style.setProperty('--agent-width', `${agentWidth}px`);
    agentResize.setAttribute('aria-valuenow', String(Math.round(agentWidth)));
    agentResize.setAttribute('aria-valuemax', String(Math.round(maxWidth)));
    agentResize.setAttribute('aria-valuetext', `${Math.round(agentWidth)} pixels`);
    if (persist) {
      try { localStorage.setItem(agentWidthStorageKey, String(Math.round(agentWidth))); } catch { /* Resizing still works for this session. */ }
    }
  }

  function setEditorWidth(width: number, persist = true): void {
    const workMinWidth = window.matchMedia('(max-width: 1120px)').matches ? 330 : 380;
    const maxWidth = Math.max(minEditorWidth, Math.min(720, studio.clientWidth - agentWidth - workMinWidth - 8));
    editorWidth = Math.max(minEditorWidth, Math.min(maxWidth, width));
    studio.style.setProperty('--editor-width', `${editorWidth}px`);
    editorResize.setAttribute('aria-valuenow', String(Math.round(editorWidth)));
    editorResize.setAttribute('aria-valuemax', String(Math.round(maxWidth)));
    editorResize.setAttribute('aria-valuetext', `${Math.round(editorWidth)} pixels`);
    if (persist) {
      try { localStorage.setItem(editorWidthStorageKey, String(Math.round(editorWidth))); } catch { /* Resizing still works for this session. */ }
    }
  }

  setAgentWidth(agentWidth, false);
  setEditorWidth(editorWidth, false);
  let resizingAgent = false;
  agentResize.addEventListener('pointerdown', (event) => {
    if (narrowLayout.matches || event.button !== 0) return;
    resizingAgent = true;
    agentResize.dataset.dragging = 'true';
    agentResize.setPointerCapture(event.pointerId);
    event.preventDefault();
  });
  agentResize.addEventListener('pointermove', (event) => {
    if (resizingAgent) setAgentWidth(event.clientX - studio.getBoundingClientRect().left);
  });
  const stopAgentResize = () => {
    resizingAgent = false;
    delete agentResize.dataset.dragging;
  };
  agentResize.addEventListener('pointerup', stopAgentResize);
  agentResize.addEventListener('pointercancel', stopAgentResize);
  agentResize.addEventListener('keydown', (event) => {
    if (narrowLayout.matches) return;
    const currentMax = Number(agentResize.getAttribute('aria-valuemax')) || 720;
    if (event.key === 'ArrowLeft') setAgentWidth(agentWidth - 16);
    else if (event.key === 'ArrowRight') setAgentWidth(agentWidth + 16);
    else if (event.key === 'Home') setAgentWidth(minAgentWidth);
    else if (event.key === 'End') setAgentWidth(currentMax);
    else return;
    event.preventDefault();
  });
  let resizingEditor = false;
  editorResize.addEventListener('pointerdown', (event) => {
    if (narrowLayout.matches || event.button !== 0) return;
    resizingEditor = true;
    editorResize.dataset.dragging = 'true';
    editorResize.setPointerCapture(event.pointerId);
    event.preventDefault();
  });
  editorResize.addEventListener('pointermove', (event) => {
    if (resizingEditor) setEditorWidth(studio.getBoundingClientRect().right - event.clientX);
  });
  const stopEditorResize = () => {
    resizingEditor = false;
    delete editorResize.dataset.dragging;
  };
  editorResize.addEventListener('pointerup', stopEditorResize);
  editorResize.addEventListener('pointercancel', stopEditorResize);
  editorResize.addEventListener('keydown', (event) => {
    if (narrowLayout.matches) return;
    const currentMax = Number(editorResize.getAttribute('aria-valuemax')) || 720;
    if (event.key === 'ArrowLeft') setEditorWidth(editorWidth + 16);
    else if (event.key === 'ArrowRight') setEditorWidth(editorWidth - 16);
    else if (event.key === 'Home') setEditorWidth(minEditorWidth);
    else if (event.key === 'End') setEditorWidth(currentMax);
    else return;
    event.preventDefault();
  });
  window.addEventListener('resize', () => {
    setAgentWidth(agentWidth, false);
    setEditorWidth(editorWidth, false);
  });
  const picker = document.querySelector<HTMLSelectElement>('#cv-picker')!;
  const paper = document.querySelector<HTMLElement>('#cv-paper')!;
  const templatePreviewStyle = document.createElement('style');
  templatePreviewStyle.id = 'active-template-preview-style';
  document.head.append(templatePreviewStyle);
  const editor = document.querySelector<HTMLElement>('#editor-content')!;
  const sectionList = document.querySelector<HTMLElement>('#section-list')!;
  const saveState = document.querySelector<HTMLElement>('#save-state')!;
  const saveLabel = document.querySelector<HTMLElement>('#save-label')!;
  const pasteboard = document.querySelector<HTMLElement>('#pasteboard')!;
  const printPageStyle = document.createElement('style');
  printPageStyle.id = 'active-paper-profile';
  document.head.append(printPageStyle);
  const settingsStatus = document.querySelector<HTMLElement>('#settings-status')!;
  const settingsToggle = document.querySelector<HTMLButtonElement>('#settings-toggle')!;
  const settingsPopover = document.querySelector<HTMLElement>('#settings-popover')!;
  const settingsStatusLabel = document.querySelector<HTMLElement>('#workspace-settings-status')!;
  const workspaceNameInput = document.querySelector<HTMLInputElement>('#workspace-name-input')!;
  const workspaceNameLabel = document.querySelector<HTMLElement>('#workspace-name')!;
  const zoomPreference = document.querySelector<HTMLInputElement>('#settings-zoom')!;
  const zoomPreferenceValue = document.querySelector<HTMLOutputElement>('#settings-zoom-value')!;
  const agentWidthPreference = document.querySelector<HTMLInputElement>('#settings-agent-width')!;
  const agentWidthPreferenceValue = document.querySelector<HTMLOutputElement>('#settings-agent-width-value')!;
  const editorWidthPreference = document.querySelector<HTMLInputElement>('#settings-editor-width')!;
  const editorWidthPreferenceValue = document.querySelector<HTMLOutputElement>('#settings-editor-width-value')!;
  const agentProviderSelect = document.querySelector<HTMLSelectElement>('#agent-provider-select')!;
  const agentProviderStatus = document.querySelector<HTMLElement>('#agent-provider-status')!;
  const agentModelSelect = document.querySelector<HTMLSelectElement>('#agent-model-select')!;
  const agentPermissionSelect = document.querySelector<HTMLSelectElement>('#agent-permission-select')!;
  const agentSessionStart = document.querySelector<HTMLButtonElement>('#agent-session-start')!;
  const agentSessionResume = document.querySelector<HTMLButtonElement>('#agent-session-resume')!;
  const agentSessionApply = document.querySelector<HTMLButtonElement>('#agent-session-apply')!;
  const agentActiveSessionLabel = document.querySelector<HTMLElement>('#agent-active-session')!;
  const agentSavedSessionList = document.querySelector<HTMLElement>('#agent-saved-session-list')!;
  const agentSettingsStatus = document.querySelector<HTMLElement>('#agent-settings-status')!;
  const activeAgentSessionKey = 'seevee.active-agent-session';
  let agentSettingsSnapshot: AgentSettingsSnapshot = { providers: [], sessions: [], events: [] };
  let savedAgentSettings: SavedAgentSetting[] = [];
  let selectedAgentSessionId: string | null = null;
  let loadedAgentOptionsSessionId: string | null = null;
  let workspaceSettingsRevision: number | null = null;
  let workspaceSettingsLoaded = false;
  let workspaceSettingsQueue: Promise<void> = Promise.resolve();
  const assetInput = document.querySelector<HTMLInputElement>('#asset-input')!;
  const assetDropzone = document.querySelector<HTMLButtonElement>('#asset-dropzone')!;
  const assetPurpose = document.querySelector<HTMLSelectElement>('#asset-purpose')!;
  const assetList = document.querySelector<HTMLUListElement>('#asset-list')!;
  const assetCount = document.querySelector<HTMLElement>('#asset-count')!;
  const assetStatus = document.querySelector<HTMLElement>('#asset-status')!;
  const commentButton = document.querySelector<HTMLButtonElement>('#place-comment')!;
  const commentDialog = document.querySelector<HTMLDialogElement>('#comment-dialog')!;
  const commentForm = document.querySelector<HTMLFormElement>('#comment-form')!;
  const commentBody = document.querySelector<HTMLTextAreaElement>('#comment-body')!;
  const commentLabel = document.querySelector<HTMLElement>('#comment-placement-label')!;
  const commentList = document.querySelector<HTMLElement>('#comment-list')!;
  const commentCount = document.querySelector<HTMLElement>('#comment-count')!;
  const contextMenu = document.querySelector<HTMLElement>('#editor-context-menu')!;
  const zoomReadout = document.querySelector<HTMLButtonElement>('#zoom-readout')!;
  const zoomOutButton = document.querySelector<HTMLButtonElement>('[data-zoom="-"]')!;
  const zoomInButton = document.querySelector<HTMLButtonElement>('[data-zoom="+"]')!;
  const zoomStorageKey = 'seevee.dashboard.zoom';
  const zoomModeStorageKey = 'seevee.dashboard.zoom-mode';
  const modeStorageKey = 'seevee.dashboard.document-mode';
  const disclosureStoragePrefix = 'seevee.dashboard.disclosure.';
  let cv: CvDoc | null = null;
  let baseRevision = 0;
  let editCount = 0;
  let savedCount = 0;
  let saveTimer: number | undefined;
  let saving = false;
  type WorkspaceCvEvent = { type: 'cv.updated'; cvId: string; revision: number };
  let pendingWorkspaceCvEvent: WorkspaceCvEvent | null = null;
  let workspaceCvRefreshTimer: number | undefined;
  let workspaceCvRefreshInFlight = false;
  let zoom = 1;
  let zoomMode: 'fit' | 'manual' = 'fit';
  let documentMode: 'preview' | 'edit' = 'preview';
  try {
    const savedZoom = Number(localStorage.getItem(zoomStorageKey));
    const savedZoomMode = localStorage.getItem(zoomModeStorageKey);
    if (Number.isFinite(savedZoom) && savedZoom >= 0.4 && savedZoom <= 2) {
      zoom = savedZoom;
      zoomMode = savedZoomMode === 'fit' ? 'fit' : 'manual';
    }
    const savedMode = localStorage.getItem(modeStorageKey);
    if (savedMode === 'preview' || savedMode === 'edit') documentMode = savedMode;
  } catch { /* Keep the initial dashboard view when browser storage is unavailable. */ }
  paper.style.setProperty('--paper-zoom', String(zoom));
  syncZoomControls();

  function syncZoomControls() {
    const percent = Math.round(zoom * 100);
    zoomReadout.textContent = `${percent}%`;
    zoomReadout.setAttribute('aria-label', `Current zoom ${percent} percent. Reset zoom to 100 percent`);
    zoomOutButton.disabled = zoom <= 0.4;
    zoomInButton.disabled = zoom >= 2;
  }

  function setZoom(value: number, mode: 'fit' | 'manual' = 'manual') {
    zoom = Math.max(0.4, Math.min(2, value));
    zoomMode = mode;
    paper.style.setProperty('--paper-zoom', String(zoom));
    syncZoomControls();
    try {
      localStorage.setItem(zoomStorageKey, String(zoom));
      localStorage.setItem(zoomModeStorageKey, zoomMode);
    } catch { /* Zoom remains active for this session. */ }
    if (zoomPreference) {
      zoomPreference.value = String(Math.round(zoom * 100));
      zoomPreferenceValue.textContent = `${Math.round(zoom * 100)}%`;
    }
  }

  function fitPageToWidth() {
    const availableWidth = Math.max(160, pasteboard.clientWidth - 88);
    setZoom(availableWidth / (pageProfile.width * 96 / 25.4), 'fit');
  }

  function setSettingsView(section: string) {
    settingsPopover.querySelectorAll<HTMLButtonElement>('[data-settings-section]').forEach((button) => {
      if (button.dataset.settingsSection === section) button.setAttribute('aria-current', 'page');
      else button.removeAttribute('aria-current');
    });
    settingsPopover.querySelectorAll<HTMLElement>('[data-settings-view]').forEach((view) => {
      view.hidden = view.dataset.settingsView !== section;
    });
  }

  function syncSettingsPreferences() {
    zoomPreference.value = String(Math.round(zoom * 100));
    zoomPreferenceValue.textContent = `${Math.round(zoom * 100)}%`;
    agentWidthPreference.value = String(Math.round(agentWidth / 10) * 10);
    agentWidthPreferenceValue.textContent = `${Math.round(agentWidth)} px`;
    editorWidthPreference.value = String(Math.round(editorWidth / 10) * 10);
    editorWidthPreferenceValue.textContent = `${Math.round(editorWidth)} px`;
  }


  function agentRequestHeaders(): HeadersInit {
    return { 'content-type': 'application/json', 'x-seevee-agent': '1' };
  }

  async function readAgentResponse<T>(response: Response): Promise<T> {
    const payload = await response.json() as T & { ok?: boolean; reason?: string };
    if (!response.ok || payload.ok === false) throw new Error(payload.reason ?? `Agent request failed with status ${response.status}.`);
    return payload;
  }
  async function loadAgentSessionOptions(sessionId: string): Promise<void> {
    loadedAgentOptionsSessionId = null;
    agentModelSelect.disabled = true;
    agentPermissionSelect.disabled = true;
    try {
      const response = await fetch(`/api/agents/session/${encodeURIComponent(sessionId)}/options`, { headers: { accept: 'application/json' } });
      const payload = await readAgentResponse<{ configuration: AgentSessionConfiguration }>(response);
      if (selectedAgentSessionId !== sessionId) return;
      const modelOptions = document.createDocumentFragment();
      const defaultModel = document.createElement('option');
      defaultModel.value = '';
      defaultModel.textContent = 'Provider default';
      modelOptions.append(defaultModel);
      for (const option of payload.configuration.models) {
        const item = document.createElement('option');
        item.value = option.id;
        item.textContent = option.label;
        item.title = option.description ?? option.label;
        modelOptions.append(item);
      }
      agentModelSelect.replaceChildren(modelOptions);
      agentModelSelect.value = payload.configuration.model ?? '';
      const permissionOptions = document.createDocumentFragment();
      const defaultPermission = document.createElement('option');
      defaultPermission.value = '';
      defaultPermission.textContent = 'Provider default';
      permissionOptions.append(defaultPermission);
      for (const option of payload.configuration.permissions) {
        const item = document.createElement('option');
        item.value = option.id;
        item.textContent = option.label;
        item.title = option.description ?? option.label;
        permissionOptions.append(item);
      }
      agentPermissionSelect.replaceChildren(permissionOptions);
      agentPermissionSelect.value = payload.configuration.permissionMode;
      loadedAgentOptionsSessionId = sessionId;
      agentModelSelect.disabled = false;
      agentPermissionSelect.disabled = false;
    } catch (reason) {
      agentModelSelect.replaceChildren(new Option('Options unavailable', ''));
      agentPermissionSelect.replaceChildren(new Option('Options unavailable', ''));
      agentSettingsStatus.textContent = reason instanceof Error ? reason.message : String(reason);
    }
  }


  function renderAgentSettings(preferredProvider?: AgentProviderId): void {
    const currentProvider = preferredProvider ?? (agentProviderSelect.value as AgentProviderId | '');
    agentProviderSelect.replaceChildren(...agentSettingsSnapshot.providers.map((provider) => {
      const option = document.createElement('option');
      option.value = provider.id;
      option.textContent = `${provider.label} · ${provider.version ?? 'not installed'}`;
      option.disabled = !provider.ready;
      return option;
    }));
    agentProviderSelect.disabled = agentSettingsSnapshot.providers.length === 0;
    let storedSessionId: string | null = null;
    try { storedSessionId = localStorage.getItem(activeAgentSessionKey); } catch { storedSessionId = null; }
    const activeSession = agentSettingsSnapshot.sessions.find((session) => session.id === selectedAgentSessionId)
      ?? agentSettingsSnapshot.sessions.find((session) => session.id === storedSessionId)
      ?? agentSettingsSnapshot.sessions.at(-1)
      ?? null;
    selectedAgentSessionId = activeSession?.id ?? null;
    const providerId = agentSettingsSnapshot.providers.some((provider) => provider.id === currentProvider)
      ? currentProvider
      : activeSession?.provider ?? agentSettingsSnapshot.providers.find((provider) => provider.ready)?.id;
    if (providerId !== undefined) agentProviderSelect.value = providerId;
    const provider = agentSettingsSnapshot.providers.find((item) => item.id === providerId);
    agentProviderStatus.textContent = provider === undefined
      ? 'No local agents detected.'
      : `${provider.status} · ${provider.message ?? provider.label}`;
    agentSessionStart.disabled = provider?.ready !== true;
    agentSessionResume.disabled = savedAgentSettings.find((session) => session.provider === providerId) === undefined;
    agentSessionApply.disabled = activeSession === null;
    if (activeSession === null) {
      loadedAgentOptionsSessionId = null;
      agentModelSelect.replaceChildren(new Option('No active session', ''));
      agentPermissionSelect.replaceChildren(new Option('No active session', ''));
      agentModelSelect.disabled = true;
      agentPermissionSelect.disabled = true;
    } else if (loadedAgentOptionsSessionId !== activeSession.id) {
      agentModelSelect.replaceChildren(new Option('Loading models…', ''));
      agentPermissionSelect.replaceChildren(new Option('Loading permissions…', ''));
      agentModelSelect.disabled = true;
      agentPermissionSelect.disabled = true;
      void loadAgentSessionOptions(activeSession.id);
    }
    agentActiveSessionLabel.textContent = activeSession === null
      ? 'None'
      : `${activeSession.title} · ${activeSession.provider} · ${activeSession.state}`;
    if (activeSession !== null) {
      try { localStorage.setItem(activeAgentSessionKey, activeSession.id); } catch { /* The current page still keeps the active session. */ }
    }
    if (savedAgentSettings.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'settings-description';
      empty.textContent = 'No saved sessions.';
      agentSavedSessionList.replaceChildren(empty);
    } else {
      agentSavedSessionList.replaceChildren(...savedAgentSettings.map((saved) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset['agentResume'] = saved.externalSessionId;
        const name = document.createElement('span');
        name.textContent = `${saved.provider} · ${saved.title}`;
        const date = document.createElement('small');
        date.textContent = new Date(saved.lastActivityAt).toLocaleString();
        button.append(name, date);
        return button;
      }));
    }
  }

  async function loadAgentSettings(refreshProviders = false): Promise<void> {
    agentSettingsStatus.textContent = 'Detecting local agents…';
    const response = await fetch(`/api/agents${refreshProviders ? '?refresh=1' : ''}`, { cache: 'no-store' });
    const payload = await readAgentResponse<AgentSettingsResponse>(response);
    agentSettingsSnapshot = payload.snapshot;
    savedAgentSettings = payload.savedSessions;
    renderAgentSettings();
    agentSettingsStatus.textContent = `${payload.snapshot.providers.filter((provider) => provider.ready).length} agents ready.`;
  }

  function activateAgentSession(session: AgentSessionSetting): void {
    selectedAgentSessionId = session.id;
    agentSettingsSnapshot = {
      ...agentSettingsSnapshot,
      sessions: [...agentSettingsSnapshot.sessions.filter((item) => item.id !== session.id), session],
    };
    try { localStorage.setItem(activeAgentSessionKey, session.id); } catch { /* The active page still receives the session. */ }
    window.dispatchEvent(new CustomEvent('seevee:agent-session-selected', { detail: session }));
    renderAgentSettings(session.provider);
  }

  async function startSelectedAgent(): Promise<void> {
    const provider = agentProviderSelect.value as AgentProviderId;
    agentSettingsStatus.textContent = 'Starting agent session…';
    try {
      const response = await fetch('/api/agents/session', {
        method: 'POST',
        headers: agentRequestHeaders(),
        body: JSON.stringify({ provider }),
      });
      const payload = await readAgentResponse<{ session: AgentSessionSetting }>(response);
      activateAgentSession(payload.session);
      agentSettingsStatus.textContent = `${payload.session.provider} session started.`;
    } catch (error) {
      agentSettingsStatus.textContent = error instanceof Error ? error.message : String(error);
    }
  }

  async function resumeAgentSession(externalSessionId: string): Promise<void> {
    const saved = savedAgentSettings.find((session) => session.externalSessionId === externalSessionId);
    if (saved === undefined) return;
    agentSettingsStatus.textContent = 'Resuming agent session…';
    try {
      const response = await fetch('/api/agents/session', {
        method: 'POST',
        headers: agentRequestHeaders(),
        body: JSON.stringify({ provider: saved.provider, resumeSessionId: saved.externalSessionId }),
      });
      const payload = await readAgentResponse<{ session: AgentSessionSetting }>(response);
      activateAgentSession(payload.session);
      agentSettingsStatus.textContent = `${payload.session.provider} session resumed.`;
    } catch (error) {
      agentSettingsStatus.textContent = error instanceof Error ? error.message : String(error);
    }
  }

  async function applyAgentConfiguration(): Promise<void> {
    if (selectedAgentSessionId === null) return;
    agentSettingsStatus.textContent = 'Applying agent configuration…';
    try {
      const model = agentModelSelect.value.trim();
      const permission = agentPermissionSelect.value.trim();
      const response = await fetch(`/api/agents/session/${encodeURIComponent(selectedAgentSessionId)}`, {
        method: 'PATCH',
        headers: agentRequestHeaders(),
        body: JSON.stringify({
          ...(model.length === 0 ? {} : { model }),
          ...(permission.length === 0 ? {} : { permissionMode: permission }),
        }),
      });
      const payload = await readAgentResponse<{ session: AgentSessionSetting }>(response);
      loadedAgentOptionsSessionId = null;
      activateAgentSession(payload.session);
      agentSettingsStatus.textContent = 'Agent configuration applied.';
    } catch (error) {
      agentSettingsStatus.textContent = error instanceof Error ? error.message : String(error);
    }
  }

  function revealSettingsPopover(): void {
    settingsPopover.hidden = false;
    settingsPopover.inert = false;
    gsap.killTweensOf(settingsPopover);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    gsap.fromTo(settingsPopover, { opacity: 0, y: -5, scale: 0.99 }, { opacity: 1, y: 0, scale: 1, duration: 0.16, ease: 'power2.out', clearProps: 'transform,visibility,opacity' });
  }

  function dismissSettingsPopover(): void {
    settingsPopover.inert = true;
    gsap.killTweensOf(settingsPopover);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      settingsPopover.hidden = true;
      return;
    }
    gsap.to(settingsPopover, { autoAlpha: 0, y: -4, duration: 0.12, ease: 'power1.in', onComplete: () => { settingsPopover.hidden = true; gsap.set(settingsPopover, { clearProps: 'all' }); } });
  }

  function openAgentSettings(): void {
    revealSettingsPopover();
    loadedAgentOptionsSessionId = null;
    settingsToggle.setAttribute('aria-expanded', 'true');
    setSettingsView('agents');
    void loadAgentSettings(true);
  }
  async function loadWorkspaceSettings() {
    settingsStatusLabel.dataset.state = 'saving';
    settingsStatusLabel.textContent = 'Loading workspace settings…';
    try {
      const response = await fetch('/api/workspace/settings');
      const result = await response.json() as { ok: boolean; settings?: { id: string; revision: number; name: string; policy: Record<string, boolean> }; reason?: string };
      if (!response.ok || !result.settings) throw new Error(result.reason ?? 'Could not load workspace settings.');
      workspaceSettingsRevision = result.settings.revision;
      workspaceSettingsLoaded = true;
      workspaceNameInput.value = result.settings.name;
      workspaceNameLabel.textContent = result.settings.name;
      document.querySelector<HTMLElement>('#settings-context-name')!.textContent = result.settings.name;
      workspaceNameInput.disabled = false;
      document.querySelectorAll<HTMLInputElement>('[data-workspace-policy]').forEach((input) => {
        const key = input.dataset.workspacePolicy;
        if (key) input.checked = result.settings!.policy[key] ?? false;
        input.disabled = false;
      });
      settingsStatusLabel.dataset.state = 'saved';
      settingsStatusLabel.textContent = 'Workspace settings are saved in seevee.json.';
    } catch (error) {
      settingsStatusLabel.dataset.state = 'error';
      settingsStatusLabel.textContent = error instanceof Error ? error.message : 'Could not load workspace settings.';
    }
  }

  function saveWorkspaceSettings(patch: { name?: string; policy?: Record<string, boolean> }) {
    workspaceSettingsQueue = workspaceSettingsQueue.then(async () => {
      if (!workspaceSettingsLoaded || workspaceSettingsRevision === null) return;
      settingsStatusLabel.dataset.state = 'saving';
      settingsStatusLabel.textContent = 'Saving workspace settings…';
      try {
        const response = await fetch('/api/workspace/settings', {
          method: 'PATCH', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ expectedRevision: workspaceSettingsRevision, ...patch }),
        });
        const result = await response.json() as { ok: boolean; settings?: { revision: number; name: string; policy: Record<string, boolean> }; reason?: string };
        if (response.status === 409) {
          workspaceSettingsLoaded = false;
          await loadWorkspaceSettings();
          throw new Error('Workspace settings changed elsewhere. Latest values are loaded; apply your change again.');
        }
        if (!response.ok || !result.settings) throw new Error(result.reason ?? 'Could not save workspace settings.');
        workspaceSettingsRevision = result.settings.revision;
        if (patch.name !== undefined) {
          workspaceNameInput.value = result.settings.name;
          workspaceNameLabel.textContent = result.settings.name;
          document.querySelector<HTMLElement>('#settings-context-name')!.textContent = result.settings.name;
          document.querySelector<HTMLElement>('#settings-about-workspace-name')!.textContent = result.settings.name;
        }
        settingsStatusLabel.dataset.state = 'saved';
        settingsStatusLabel.textContent = 'Workspace settings saved.';
      } catch (error) {
        settingsStatusLabel.dataset.state = 'error';
        settingsStatusLabel.textContent = error instanceof Error ? error.message : 'Could not save workspace settings.';
      }
    });
    return workspaceSettingsQueue;
  }

