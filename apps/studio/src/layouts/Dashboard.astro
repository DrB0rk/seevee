  function addCustomField(entryId: string) {
    const item = cv?.data.entities.custom?.[entryId];
    if (!item) return;
    let key = 'new_field';
    let suffix = 2;
    while (key in item.data) key = `new_field_${suffix++}`;
    item.data[key] = '';
    markChanged();
    render();
    openEditorGroup(`edit-custom-entry-${entryId}`);
    editor.querySelector<HTMLInputElement>(`[data-custom-field-key="${CSS.escape(entryId)}.${CSS.escape(key)}"]`)?.focus();
  }

  function renameCustomField(ownerAndKey: string, rawKey: string) {
    const dot = ownerAndKey.indexOf('.');
    if (!cv || dot < 0) return;
    const entryId = ownerAndKey.slice(0, dot);
    const oldKey = ownerAndKey.slice(dot + 1);
    const item = cv.data.entities.custom?.[entryId];
    const nextKey = rawKey.trim().toLowerCase().replace(/[^a-z0-9_-]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 50);
    if (!item || !oldKey || !nextKey || !isEditableCustomFieldKey(nextKey) || (nextKey !== oldKey && nextKey in item.data)) {
      renderEditor();
      return;
    }
    if (nextKey !== oldKey) {
      item.data[nextKey] = item.data[oldKey];
      delete item.data[oldKey];
      markChanged();
      render();
      openEditorGroup(`edit-custom-entry-${entryId}`);
    }
  }

  function removeCustomEntry(entryId: string) {
    if (!cv) return;
    delete cv.data.entities.custom?.[entryId];
    for (const section of Object.values(cv.data.sections)) {
      if (section.nodeOrder) section.nodeOrder = section.nodeOrder.filter((id) => id !== entryId);
    }
    markChanged();
    render();
  }

  function removeCustomSection(sectionId: string) {
    if (!cv) return;
    const section = cv.data.sections[sectionId];
    if (!section || section.type !== 'custom') return;
    const entryIds = section.nodeOrder ?? [];
    delete cv.data.sections[sectionId];
    cv.data.sectionOrder = cv.data.sectionOrder.filter((id) => id !== sectionId);
    for (const entryId of entryIds) {
      const stillUsed = Object.values(cv.data.sections).some((other) => other.type === 'custom' && other.nodeOrder?.includes(entryId));
      if (!stillUsed) delete cv.data.entities.custom?.[entryId];
    }
    markChanged();
    render();
  }

  function removeCustomField(ownerAndKey: string) {
    const dot = ownerAndKey.indexOf('.');
    if (!cv || dot < 0) return;
    const item = cv.data.entities.custom?.[ownerAndKey.slice(0, dot)];
    if (!item) return;
    delete item.data[ownerAndKey.slice(dot + 1)];
    markChanged();
    render();
  }

  function addBullet(experienceId: string) {
    const experience = cv?.data.entities.experience?.[experienceId];
    if (!experience) return;
    const id = `bullet_${Date.now().toString(36)}`;
    experience.bullets[id] = { id, text: 'Describe a result you delivered.' };
    experience.bulletOrder.push(id);
    markChanged();
    render();
  }

  function addProjectBullet(projectId: string) {
    const project = cv?.data.entities.projects?.[projectId];
    if (!project) return;
    const id = `project_bullet_${Date.now().toString(36)}`;
    project.bullets ??= {};
    project.bulletOrder ??= [];
    project.bullets[id] = { id, text: 'Describe a project result.' };
    project.bulletOrder.push(id);
    markChanged();
    render();
  }

  function removeExperience(id: string) {
    if (!cv?.data.entities.experience?.[id]) return;
    delete cv.data.entities.experience[id];
    for (const section of Object.values(cv.data.sections)) {
      if (section.nodeOrder) section.nodeOrder = section.nodeOrder.filter((nodeId) => nodeId !== id);
    }
    markChanged();
    render();
  }

  studio.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
    const path = target.dataset.field;
    if (!path || !cv) return;
    setPath(path, target.value);
    const editingPaper = paper.contains(target);
    if (path.startsWith('sections.')) renderSections();
    if (path.startsWith('custom.') && path.endsWith('.label')) {
      const heading = target.closest('details.editor-group')?.querySelector<HTMLElement>('.group-heading-title');
      if (heading) heading.textContent = target.value || 'Custom entry';
    }
    if (editingPaper && target instanceof HTMLTextAreaElement) {
      target.style.height = 'auto';
      target.style.height = `${target.scrollHeight}px`;
    }
    if (editingPaper) document.querySelector('#preview-name')!.textContent = cv.data.identity.name.display || 'Untitled CV';
    markChanged(!editingPaper);
  });

  studio.addEventListener('change', (event) => {
    const input = event.target instanceof HTMLInputElement ? event.target : null;
    const fieldKey = input?.dataset.customFieldKey;
    if (fieldKey) {
      renameCustomField(fieldKey, input?.value ?? '');
      return;
    }
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || !cv) return;
    if (target.type === 'number' && target.value === '' && target.dataset.field) {
      let current: unknown = cv;
      for (const key of target.dataset.field.split('.')) current = current && typeof current === 'object' ? (current as Record<string, unknown>)[key] : undefined;
      target.value = current === undefined || current === null ? '' : String(current);
    }
    if (target.dataset.ongoingFor) {
      const experience = cv.data.entities.experience?.[target.dataset.ongoingFor];
      if (!experience) return;
      experience.period.ongoing = target.checked;
      if (target.checked) delete experience.period.end;
    } else if (target.dataset.ongoingProjectFor) {
      const project = cv.data.entities.projects?.[target.dataset.ongoingProjectFor];
      if (!project?.period) return;
      project.period.ongoing = target.checked;
      if (target.checked) delete project.period.end;
    } else return;
    markChanged(false);
    renderEditor();
    renderPreview();
  });

  studio.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement || target instanceof HTMLSelectElement)) return;
    if (target.id === 'setting-page-preset' || target.id === 'setting-orientation' || target.id === 'setting-page-width' || target.id === 'setting-page-height' || target.matches('[data-page-margin]')) {
      updatePageSettings();
      return;
    }
    if (target.id === 'setting-font-family') updateStyleToken('font-family', 'string', target.value);
    else if (target.id === 'setting-font-size') updateStyleToken('base-font-size', 'number', Math.min(14, Math.max(9, Number(target.value) || classicStyle.baseFontSize)));
    else if (target.id === 'setting-line-height') updateStyleToken('line-height', 'number', Math.min(2, Math.max(1, Number(target.value) || classicStyle.lineHeight)));
    else if (target.id === 'setting-accent-color' && /^#[\da-f]{6}$/i.test(target.value)) updateStyleToken('accent-color', 'color', target.value);
  });

  studio.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('#add-custom-section')) return addCustomSection();
    const addCustom = target.closest<HTMLElement>('[data-add-custom-entry]')?.dataset.addCustomEntry;
    if (addCustom) return addCustomEntry(addCustom);
    const addField = target.closest<HTMLElement>('[data-add-custom-field]')?.dataset.addCustomField;
    if (addField) return addCustomField(addField);
    const removeField = target.closest<HTMLElement>('[data-remove-custom-field]')?.dataset.removeCustomField;
    if (removeField) return removeCustomField(removeField);
    const removeCustom = target.closest<HTMLElement>('[data-remove-custom-entry]')?.dataset.removeCustomEntry;
    if (removeCustom) return removeCustomEntry(removeCustom);
    const removeCustomSectionId = target.closest<HTMLElement>('[data-remove-custom-section]')?.dataset.removeCustomSection;
    if (removeCustomSectionId) return removeCustomSection(removeCustomSectionId);
    const add = target.closest('[data-add-experience], #add-experience-inline, #add-experience');
    if (add) return addExperience();
    const addKind = target.closest<HTMLElement>('[data-add-entry]')?.dataset.addEntry;
    if (addKind === 'education' || addKind === 'projects' || addKind === 'skills') return addEntry(addKind);
    const bulletOwner = target.closest<HTMLElement>('[data-add-bullet]')?.dataset.addBullet;
    if (bulletOwner) return addBullet(bulletOwner);
    const projectBullet = target.closest<HTMLElement>('[data-add-project-bullet]')?.dataset.addProjectBullet;
    if (projectBullet) return addProjectBullet(projectBullet);
    const removeBullet = target.closest<HTMLElement>('[data-remove-bullet]')?.dataset.removeBullet;
    if (removeBullet && cv) {
      const [kind, ownerId, bulletId] = removeBullet.split('.');
      const experience = kind === 'experience' ? cv.data.entities.experience?.[ownerId ?? ''] : undefined;
      const project = kind === 'projects' ? cv.data.entities.projects?.[ownerId ?? ''] : undefined;
      const bullets = experience?.bullets ?? project?.bullets;
      if (bullets && bulletId) {
        delete bullets[bulletId];
        if (experience) experience.bulletOrder = experience.bulletOrder.filter((id) => id !== bulletId);
        if (project) project.bulletOrder = project.bulletOrder?.filter((id) => id !== bulletId);
        markChanged();
        render();
      }
      return;
    }
    const projectDates = target.closest<HTMLElement>('[data-add-project-dates]')?.dataset.addProjectDates;
    if (projectDates && cv?.data.entities.projects?.[projectDates]) {
      cv.data.entities.projects[projectDates]!.period = { start: { precision: 'year', year: new Date().getFullYear() } };
      markChanged();
      render();
      return;
    }
    const projectRole = target.closest<HTMLElement>('[data-add-project-role]')?.dataset.addProjectRole;
    if (projectRole && cv?.data.entities.projects?.[projectRole]) {
      cv.data.entities.projects[projectRole]!.role = { id: `role_${Date.now().toString(36)}`, type: 'role', title: 'Project role' };
      markChanged();
      render();
      return;
    }
    const removeEntry = target.closest<HTMLElement>('[data-remove-entry]')?.dataset.removeEntry;
    if (removeEntry && cv) {
      const [kind, id] = removeEntry.split('.') as ['education' | 'projects' | 'skills', string];
      delete cv.data.entities[kind]?.[id];
      for (const item of Object.values(cv.data.sections)) if (item.nodeOrder) item.nodeOrder = item.nodeOrder.filter((nodeId) => nodeId !== id);
      markChanged();
      render();
      return;
    }
    const remove = target.closest<HTMLElement>('[data-remove-experience]');
    if (remove?.dataset.removeExperience) return removeExperience(remove.dataset.removeExperience);
    const section = target.closest<HTMLElement>('[data-section]');
    if (section?.dataset.section) {
      sectionList.querySelectorAll('[aria-current="location"]').forEach((item) => item.removeAttribute('aria-current'));
      section.setAttribute('aria-current', 'location');
      paper.querySelectorAll('.cv-section.is-section-selected').forEach((item) => item.classList.remove('is-section-selected'));
      const previewSection = paper.querySelector<HTMLElement>(`.cv-section[data-cv-section="${CSS.escape(section.dataset.section)}"]`);
      previewSection?.classList.add('is-section-selected');
      previewSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      const editorTarget = section.dataset.editorTarget;
      const group = editorTarget ? editor.querySelector<HTMLElement>(`#${CSS.escape(editorTarget)}`) : null;
      if (group instanceof HTMLDetailsElement) group.open = true;
      group?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    const zoomControl = target.closest<HTMLElement>('[data-zoom]');
    if (zoomControl?.dataset.zoom) {
      setZoom(zoom + (zoomControl.dataset.zoom === '+' ? 0.08 : -0.08));
      return;
    }
    if (target.closest('#fit-page')) fitPageToWidth();
    if (target.closest('#zoom-readout')) setZoom(1, 'manual');
    const jump = target.closest<HTMLElement>('[data-comment-jump]');
    if (jump?.dataset.commentJump) {
      paper.querySelector<HTMLElement>(`.comment-marker[data-comment-jump="${CSS.escape(jump.dataset.commentJump)}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    }
    const edit = target.closest<HTMLElement>('[data-comment-edit]')?.dataset.commentEdit;
    if (edit) return editComment(edit);
    const move = target.closest<HTMLElement>('[data-comment-move]')?.dataset.commentMove;
    if (move) {
      void beginCommentMove(move);
      return;
    }
    const removeComment = target.closest<HTMLElement>('[data-comment-delete]')?.dataset.commentDelete;
    if (removeComment) void deleteComment(removeComment).catch((error) => setStatus('error', error instanceof Error ? error.message : 'Could not delete comment.'));
  });

  commentButton.addEventListener('click', () => void beginCommentPlacement());
  paper.addEventListener('contextmenu', (event) => {
    if (!(event.target instanceof Element)) return;
    event.preventDefault();
    const bounds = event.target.getBoundingClientRect();
    const x = event.clientX || bounds.left + bounds.width / 2;
    const y = event.clientY || bounds.top + bounds.height / 2;
    openContextMenu(event.target, x, y);
  });
  contextMenu.addEventListener('click', (event) => {
    const action = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-context-action]')?.dataset.contextAction : undefined;
    const context = contextTarget;
    if (!action || !context) return;
    closeContextMenu();
    if (action === 'comment') return placeCommentAt(context.target, context.x, context.y);
    if (action === 'edit-comment' && context.commentId) return editComment(context.commentId);
    if (action === 'move-comment' && context.commentId) {
      void beginCommentMove(context.commentId);
      return;
    }
    if (action === 'delete-comment' && context.commentId) {
      void deleteComment(context.commentId).catch((error) => setStatus('error', error instanceof Error ? error.message : 'Could not delete comment.'));
      return;
    }
    if (action === 'edit-field') return focusEditorFor(context.target, context.described.fieldPath);
    if (action === 'edit-entry') return focusEditorFor(context.target);
    if (action === 'add-result') {
      const id = context.target.closest<HTMLElement>('[data-node-type="experience"]')?.dataset.nodeId;
      if (id) void addBullet(id);
      return;
    }
    const kind = action === 'add-education' ? 'education' : action === 'add-project' ? 'projects' : action === 'add-skill' ? 'skills' : null;
    if (kind) {
      editor.querySelector<HTMLButtonElement>(`[data-add-entry="${kind}"]`)?.click();
      return;
    }
    if (action === 'add-experience') void addExperience();
  });
  contextMenu.addEventListener('keydown', (event) => {
    const items = Array.from(contextMenu.querySelectorAll<HTMLButtonElement>('[role="menuitem"]'));
    const index = items.indexOf(document.activeElement as HTMLButtonElement);
    if (event.key === 'Escape') {
      event.preventDefault();
      const target = contextTarget?.target;
      closeContextMenu();
      if (target instanceof HTMLElement) target.focus();
    } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp' || event.key === 'Home' || event.key === 'End') {
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
      items[next]?.focus();
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (!contextMenu.hidden && event.target instanceof Node && !contextMenu.contains(event.target)) closeContextMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !contextMenu.hidden) closeContextMenu();
    else if (event.key === 'Escape' && movingCommentId) finishCommentMove();
  });
  paper.addEventListener('click', captureCommentPlacement, true);
  paper.addEventListener('focusout', (event) => {
    if (event.target instanceof HTMLElement && event.target.hasAttribute('data-field')) window.setTimeout(renderPreview, 0);
  });
  paper.addEventListener('pointerdown', (event) => {
    const marker = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('.comment-marker') : null;
    if (!marker?.dataset.commentJump) return;
    draggingComment = { id: marker.dataset.commentJump, pointerId: event.pointerId, moved: false };
    marker.setPointerCapture(event.pointerId);
    event.preventDefault();
    event.stopPropagation();
  });
  paper.addEventListener('pointermove', (event) => {
    if (!draggingComment || draggingComment.pointerId !== event.pointerId) return;
    const marker = paper.querySelector<HTMLElement>(`.comment-marker[data-comment-jump="${CSS.escape(draggingComment.id)}"]`);
    if (!marker) return;
    const point = locationOnPage(event.clientX, event.clientY, marker);
    marker.style.left = `${point.x * 100}%`;
    marker.style.top = `${point.y * 100}%`;
    draggingComment.moved = true;
    event.preventDefault();
  });
  paper.addEventListener('pointerup', (event) => {
    if (!draggingComment || draggingComment.pointerId !== event.pointerId) return;
    const drag = draggingComment;
    draggingComment = null;
    if (!drag.moved) return;
    const destination = document.elementsFromPoint(event.clientX, event.clientY).find((element) => !element.closest('.comment-marker'));
    const element = destination instanceof Element ? destination : paper;
    const point = locationOnPage(event.clientX, event.clientY, element);
    const described = describePlacement(element);
    void moveComment(drag.id, point.x, point.y, { element: described.element, contextText: described.contextText ?? null, fieldPath: described.fieldPath ?? null, selector: described.selector }, point.page).catch((error) => setStatus('error', error instanceof Error ? error.message : 'Could not move comment.'));
    event.preventDefault();
  });
  paper.addEventListener('keydown', (event) => {
    const marker = event.target instanceof Element ? event.target.closest<HTMLElement>('.comment-marker') : null;
    if (!marker?.dataset.commentJump || !['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
    const thread = commentsDocument?.data.threads[marker.dataset.commentJump];
    const current = thread ? placementOf(thread) : null;
    if (!current) return;
    event.preventDefault();
    const delta = event.shiftKey ? 0.05 : 0.01;
    const x = Math.max(0, Math.min(0.985, current.x + (event.key === 'ArrowRight' ? delta : event.key === 'ArrowLeft' ? -delta : 0)));
    const y = Math.max(0, Math.min(0.985, current.y + (event.key === 'ArrowDown' ? delta : event.key === 'ArrowUp' ? -delta : 0)));
    void moveComment(marker.dataset.commentJump, x, y, undefined, current.page).catch((error) => setStatus('error', error instanceof Error ? error.message : 'Could not move comment.'));
  });
  document.querySelector<HTMLButtonElement>('#comment-cancel')?.addEventListener('click', () => {
    commentDialog.close();
    pendingPlacement = null;
  });
  commentDialog.addEventListener('cancel', () => { pendingPlacement = null; });
  commentBody.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return;
    event.preventDefault();
    commentForm.requestSubmit();
  });
  commentForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const button = document.querySelector<HTMLButtonElement>('#comment-save');
    if (button) button.disabled = true;
    void saveComment(commentBody.value).then(() => commentDialog.close()).catch((error) => {
      commentLabel.textContent = error instanceof Error ? error.message : 'Could not save comment.';
    }).finally(() => { if (button) button.disabled = false; });
  });

  picker.addEventListener('change', () => void loadCv(picker.value).catch((error) => setStatus('error', error.message)));
  document.querySelector<HTMLButtonElement>('#export-pdf')?.addEventListener('click', () => void exportPdf());
  void loadCv().then(() => processPendingWorkspaceCvEvent()).catch((error) => {
    setStatus('error', error instanceof Error ? error.message : 'Could not connect to workspace');
    paper.innerHTML = `<div class="workspace-error"><span class="eyebrow">WORKSPACE NEEDS ATTENTION</span><h2>Could not open your CV</h2><p>${escapeHtml(error instanceof Error ? error.message : 'Unknown error')}</p></div>`;
    editor.innerHTML = '<p class="quiet-message">Fix the workspace data, then reload this page.</p>';
    sectionList.innerHTML = '';
  });
</script>
