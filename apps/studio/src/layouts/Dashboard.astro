  function locationOnPage(clientX: number, clientY: number, pageElement?: Element | null) {
    const page = pageElement?.closest<HTMLElement>('.paper') ?? paper.querySelector<HTMLElement>('.paper');
    const rect = page?.getBoundingClientRect() ?? paper.getBoundingClientRect();
    return {
      page: Number(page?.dataset.pageNumber ?? 1),
      x: Math.max(0, Math.min(0.985, (clientX - rect.left) / rect.width)),
      y: Math.max(0, Math.min(0.985, (clientY - rect.top) / rect.height)),
    };
  }

  async function moveComment(threadId: string, x: number, y: number, location?: { element: string; contextText: string | null; fieldPath: string | null; selector: Record<string, unknown> | null }, page = 1) {
    if (!cv) return;
    const response = await fetch(`/api/comments/${encodeURIComponent(cv.id)}`, {
      method: 'PUT', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ expectedRevision: commentRevision, threadId, placement: { page, x, y, ...location } }),
    });
    const result = await response.json() as { ok: boolean; document?: CommentsDoc; reason?: string };
    if (!response.ok || !result.document) throw new Error(result.reason ?? 'Could not move comment.');
    commentsDocument = result.document;
    commentRevision = result.document.revision;
    renderComments();
  }

  function setPath(path: string, value: string) {
    if (!cv) return;
    const bits = path.split('.');
    if (bits[0] === 'contact' && bits[1] === 'email') {
      let email = cv.data.identity.contact.find((entry) => entry.kind === 'email');
      if (!email) {
        email = { kind: 'email', value, primary: true };
        cv.data.identity.contact.push(email);
      } else email.value = value;
      return;
    }
    if (['experience', 'education', 'projects'].includes(bits[0]!) && bits[2] === 'period' && (bits[3] === 'start' || bits[3] === 'end') && bits[4] === 'year') {
      const entity = cv.data.entities[bits[0] as 'experience' | 'education' | 'projects']?.[bits[1]!] as Record<string, unknown> | undefined;
      const period = entity?.period as Record<string, unknown> | undefined;
      if (!entity || !period || (bits[3] === 'start' && value === '')) return;
      if (bits[3] === 'end' && value === '') {
        delete period.end;
        return;
      }
      const year = Number(value);
      if (!Number.isInteger(year) || year < 1900 || year > 2200) return;
      const dateKey = bits[3]!;
      const date = (period[dateKey] && typeof period[dateKey] === 'object' ? period[dateKey] : { precision: 'year' }) as Record<string, unknown>;
      date.precision ??= 'year';
      date.year = year;
      period[dateKey] = date;
      if (dateKey === 'end' && 'ongoing' in period) period.ongoing = false;
      return;
    }
    let target: Record<string, unknown> = cv as unknown as Record<string, unknown>;
    for (const key of bits.slice(0, -1)) {
      const next = target[key];
      if (!next || typeof next !== 'object') return;
      target = next as Record<string, unknown>;
    }
    target[bits.at(-1)!] = bits.at(-1) === 'year' && value ? Number(value) : value;
  }

  async function loadCv(id?: string) {
    await presentationSaveQueue;
    setStatus('loading', 'Loading document');
    const listResponse = await fetch('/api/cv');
    if (!listResponse.ok) throw new Error('Could not read CVs from this workspace.');
    const items = await listResponse.json() as CvListItem[];
    const available = items.filter((item): item is Extract<CvListItem, { ok: true }> => item.ok);
    if (!available.length) {
      const failures = items.filter((item): item is Extract<CvListItem, { ok: false }> => !item.ok);
      if (failures.length) {
        const details = failures.map((item) => `${item.path}: ${item.reason}`).join('; ');
        throw new Error(`No registered CV could be loaded. ${details} Run seevee validate to inspect the workspace data.`);
      }
      throw new Error('No CV is registered in this workspace. Run seevee init to create one.');
    }
    picker.replaceChildren(...available.map((item) => {
      const option = document.createElement('option');
      option.value = item.cv.id;
      option.textContent = item.cv.name;
      return option;
    }));
    picker.disabled = false;
    const selected = available.find((item) => item.cv.id === id)?.cv.id ?? available[0]!.cv.id;
    picker.value = selected;
    const response = await fetch(`/api/cv/${encodeURIComponent(selected)}`);
    const payload = await response.json() as { ok: boolean; document?: CvDoc; reason?: string };
    if (!response.ok || !payload.document) throw new Error(payload.reason ?? 'Could not load this CV.');
    cv = payload.document;
    baseRevision = cv.revision;
    editCount = 0;
    savedCount = 0;
    presentationContext = { revision: 0, versionId: 'tplclassic0000000000000000001' };
    presentationId = null;
    presentationRevision = 0;
    presentationTokens = {};
    templateStyleSequence += 1;
    templatePreviewStyle.textContent = '';
    pagePreset = 'A4';
    pageOrientation = 'portrait';
    pageProfile = { width: 210, height: 297, edges: { top: 18, right: 18, bottom: 18, left: 18 } };
    applyDocumentStyle();
    try {
      const response = await fetch('/api/presentation');
      const items = await response.json() as Array<{ ok: true; presentation: { id: string; cvId: string; revision: number; templateId: string; versionId: string; preset: 'A4' | 'Letter' | 'Legal' | 'custom'; orientation: 'portrait' | 'landscape'; widthMm: number; heightMm: number; edges: { top: number; right: number; bottom: number; left: number }; tokens: Record<string, { type: string; value: unknown }> } } | { ok: false }>;
      const match = items.find((item) => item.ok && item.presentation.cvId === cv!.id);
      if (match?.ok) {
        const { presentation } = match;
        presentationId = presentation.id;
        presentationRevision = presentation.revision;
        await loadTemplatePreviewStyle(presentation.templateId, presentation.versionId);
        pagePreset = presentation.preset;
        pageOrientation = presentation.orientation;
        presentationTokens = presentation.tokens;
        presentationContext = { revision: presentation.revision, versionId: presentation.versionId };
        pageProfile = {
          width: presentation.orientation === 'landscape' ? presentation.heightMm : presentation.widthMm,
          height: presentation.orientation === 'landscape' ? presentation.widthMm : presentation.heightMm,
          edges: presentation.edges,
        };
        applyDocumentStyle(presentationTokens);
      }
    } catch { /* Keep the default render context if presentation discovery is unavailable. */ }
    syncSettingsControls();
    commentsDocument = null;
    commentRevision = 0;
    try {
      const response = await fetch(`/api/comments/${encodeURIComponent(cv.id)}`);
      if (response.ok) {
        const result = await response.json() as { document?: CommentsDoc };
        commentsDocument = result.document ?? null;
        commentRevision = commentsDocument?.revision ?? 0;
      }
    } catch { /* Comment loading can recover on the next workspace reload. */ }
    render();
    if (zoomMode === 'fit') fitPageToWidth();
    renderComments();
    setStatus('saved', 'All changes saved');
  }

  async function flushSave() {
    if (saving || !cv || editCount === savedCount) return;
    saving = true;
    setStatus('saving', 'Saving changes');
    try {
      while (cv && savedCount < editCount) {
        const snapshotCount = editCount;
        const body = structuredClone(cv);
        const response = await fetch(`/api/cv/${encodeURIComponent(body.id)}`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ expectedRevision: baseRevision, document: body }),
        });
        const payload = await response.json() as { ok: boolean; document?: CvDoc; reason?: string };
        if (response.status === 409) {
          setStatus('conflict', 'Changed elsewhere · reload to continue');
          return;
        }
        if (!response.ok || !payload.document) throw new Error(payload.reason ?? 'Save failed.');
        baseRevision = payload.document.revision;
        cv.revision = baseRevision;
        cv.updatedAt = payload.document.updatedAt;
        savedCount = snapshotCount;
      }
      if (editCount === savedCount) setStatus('saved', 'All changes saved');
    } catch (error) {
      setStatus('error', error instanceof Error ? error.message : 'Save failed');
    } finally {
      saving = false;
      if (editCount > savedCount && saveState.dataset.state !== 'conflict') {
        window.clearTimeout(saveTimer);
        saveTimer = window.setTimeout(() => void flushSave(), 250);
      }
      processPendingWorkspaceCvEvent();
    }
  }

  function queueWorkspaceCvRefresh(event: WorkspaceCvEvent) {
    if (cv !== null && cv.id !== event.cvId) return;
    if (event.revision > 0 && event.revision <= baseRevision) return;
    pendingWorkspaceCvEvent = event;
    processPendingWorkspaceCvEvent();
  }

  function processPendingWorkspaceCvEvent() {
    const event = pendingWorkspaceCvEvent;
    if (event === null || cv === null || cv.id !== event.cvId || saving || workspaceCvRefreshInFlight) return;
    if (editCount > savedCount) {
      setStatus('conflict', 'Changed in workspace · local edits are unsaved');
      return;
    }
    pendingWorkspaceCvEvent = null;
    window.clearTimeout(workspaceCvRefreshTimer);
    workspaceCvRefreshTimer = window.setTimeout(() => void refreshActiveCv(event.cvId), 90);
  }

  async function refreshActiveCv(id: string) {
    if (cv === null || cv.id !== id || saving || editCount > savedCount) {
      processPendingWorkspaceCvEvent();
      return;
    }
    workspaceCvRefreshInFlight = true;
    try {
      const response = await fetch(`/api/cv/${encodeURIComponent(id)}`, { cache: 'no-store' });
      const payload = await response.json() as { ok: boolean; document?: CvDoc; reason?: string };
      if (!response.ok || !payload.document) throw new Error(payload.reason ?? 'Could not refresh the CV from the workspace.');
      if (cv === null || cv.id !== id) return;
      if (saving || editCount > savedCount) {
        pendingWorkspaceCvEvent = { type: 'cv.updated', cvId: id, revision: payload.document.revision };
        setStatus('conflict', 'Changed in workspace · local edits are unsaved');
        return;
      }
      const remote = payload.document;
      const changed = remote.revision !== baseRevision || remote.updatedAt !== cv.updatedAt || JSON.stringify(remote.data) !== JSON.stringify(cv.data);
      if (!changed) return;
      cv = remote;
      baseRevision = remote.revision;
      editCount = 0;
      savedCount = 0;
      render();
      setStatus('saved', 'Updated live from workspace');
    } catch (error) {
      setStatus('error', error instanceof Error ? error.message : 'Could not refresh the CV.');
    } finally {
      workspaceCvRefreshInFlight = false;
      processPendingWorkspaceCvEvent();
    }
  }

  const workspaceEvents = new EventSource('/api/events');
  workspaceEvents.addEventListener('message', (message) => {
    try {
      const event = JSON.parse((message as MessageEvent<string>).data) as Partial<WorkspaceCvEvent>;
      if (event.type !== 'cv.updated' || typeof event.cvId !== 'string' || typeof event.revision !== 'number') return;
      queueWorkspaceCvRefresh(event as WorkspaceCvEvent);
    } catch { /* Ignore unrelated or malformed workspace events. */ }
  });

  async function exportPdf() {
    window.clearTimeout(saveTimer);
    while (saving) await new Promise((resolve) => window.setTimeout(resolve, 40));
    if (editCount > savedCount) await flushSave();
    if (editCount !== savedCount || saveState.dataset.state === 'conflict' || saveState.dataset.state === 'error') return;
    window.print();
  }

  function markChanged(refreshPreview = true) {
    editCount += 1;
    setStatus('saving', 'Unsaved changes');
    if (refreshPreview) renderPreview();
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => void flushSave(), 550);
  }

  function addExperience() {
    if (!cv) return;
    const stamp = Date.now().toString(36);
    const id = `experience_${stamp}`;
    const bulletId = `bullet_${stamp}`;
    const sectionId = cv.data.sectionOrder.find((section) => cv!.data.sections[section]?.type === 'experience');
    const entity = {
      id,
      type: 'experience' as const,
      organization: { id: `organization_${stamp}`, type: 'organization' as const, name: 'Organization' },
      role: { id: `role_${stamp}`, type: 'role' as const, title: 'Role title' },
      period: { start: { precision: 'year', year: new Date().getFullYear() }, ongoing: true },
      bulletOrder: [bulletId],
      bullets: { [bulletId]: { id: bulletId, text: 'Describe a result you delivered.' } },
      technologyRefs: [],
    };
    cv.data.entities.experience ??= {};
    cv.data.entities.experience[id] = entity;
    if (sectionId) cv.data.sections[sectionId]!.nodeOrder = [...(cv.data.sections[sectionId]!.nodeOrder ?? []), id];
    else {
      const newSectionId = `sec_experience_${stamp}`;
      cv.data.sections[newSectionId] = { id: newSectionId, type: 'experience', title: 'Experience', visible: true, nodeOrder: [id] };
      cv.data.sectionOrder.push(newSectionId);
    }
    markChanged();
    render();
    window.setTimeout(() => {
      openEditorGroup(`edit-${id}`);
      editor.querySelector<HTMLInputElement>(`[data-field="experience.${id}.role.title"]`)?.focus();
    }, 0);
  }

  function addEntry(kind: 'education' | 'projects' | 'skills') {
    if (!cv) return;
    const id = `${kind}_${Date.now().toString(36)}`;
    if (kind === 'education') {
      cv.data.entities.education ??= {};
      cv.data.entities.education[id] = {
        id,
        institution: { name: 'Institution' },
        program: { name: 'Program', degree: null },
        period: { start: { precision: 'year', year: new Date().getFullYear() }, end: { precision: 'year', year: new Date().getFullYear() } },
        details: [],
      };
    } else if (kind === 'projects') {
      cv.data.entities.projects ??= {};
      cv.data.entities.projects[id] = { id, type: 'project', name: 'Project', summary: '', linkRefs: [], technologyRefs: [] };
    } else {
      cv.data.entities.skills ??= {};
      cv.data.entities.skills[id] = { id, type: 'skill', name: 'Skill', keywords: [] };
    }
    const section = Object.values(cv.data.sections).find((item) => item.type === kind);
    if (section) section.nodeOrder = [...(section.nodeOrder ?? []), id];
    else {
      const sectionId = `sec_${kind}_${Date.now().toString(36)}`;
      cv.data.sections[sectionId] = { id: sectionId, type: kind, title: kind === 'projects' ? 'Projects' : kind[0]!.toUpperCase() + kind.slice(1), visible: true, nodeOrder: [id] };
      cv.data.sectionOrder.push(sectionId);
    }
    markChanged();
    render();
    openEditorGroup(kind === 'education' ? `edit-education-${id}` : kind === 'projects' ? `edit-project-${id}` : `edit-skill-${id}`);
  }

  function addCustomSection() {
