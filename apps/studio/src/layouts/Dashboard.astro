    cv.data.entities.custom[id] = { id, type: 'customEntity', label: 'New entry', data: { description: '' } };
    section.nodeOrder = [...(section.nodeOrder ?? []), id];
    markChanged();
    render();
    openEditorGroup(`edit-custom-entry-${id}`);
