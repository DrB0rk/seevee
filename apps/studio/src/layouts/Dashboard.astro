  function applyDocumentStyle(tokens?: Record<string, { type: string; value: unknown }>) {
    const token = (name: string) => tokens?.[name]?.value;
    const rawFamily = token('font-family');
    const fontFamily = typeof rawFamily === 'string'
      ? rawFamily.replace(/[;{}<>]/g, '').slice(0, 120) || classicStyle.fontFamily
      : classicStyle.fontFamily;
    const rawSize = token('base-font-size');
    const baseFontSize = typeof rawSize === 'number' && rawSize >= 9 && rawSize <= 14 ? rawSize : classicStyle.baseFontSize;
    const rawLineHeight = token('line-height');
    const lineHeight = typeof rawLineHeight === 'number' && rawLineHeight >= 1 && rawLineHeight <= 2 ? rawLineHeight : classicStyle.lineHeight;
    const rawAccent = token('accent-color');
    const accentColor = typeof rawAccent === 'string' && /^#[\da-f]{6}(?:[\da-f]{2})?$/i.test(rawAccent) ? rawAccent : classicStyle.accentColor;
    paper.style.setProperty('--cv-font-family', fontFamily);
    paper.style.setProperty('--cv-font-size', `${baseFontSize}pt`);
    paper.style.setProperty('--cv-name-size', `${baseFontSize * 2}pt`);
    paper.style.setProperty('--cv-section-size', `${baseFontSize * 1.2}pt`);
    paper.style.setProperty('--cv-small-size', `${baseFontSize - 1}pt`);
    paper.style.setProperty('--cv-line-height', String(lineHeight));
    paper.style.setProperty('--cv-accent-color', accentColor);
  }

  async function loadTemplatePreviewStyle(templateId: string, versionId: string) {
    const sequence = ++templateStyleSequence;
    templatePreviewStyle.textContent = '';
    try {
      const query = new URLSearchParams({ templateId, versionId });
      const response = await fetch(`/api/template-style?${query}`);
      if (!response.ok) return;
      const result = await response.json() as { ok: boolean; css?: string };
      if (sequence === templateStyleSequence && result.ok && typeof result.css === 'string') {
        templatePreviewStyle.textContent = result.css;
      }
    } catch {
      if (sequence === templateStyleSequence) templatePreviewStyle.textContent = '';
    }
  }

  function syncSettingsControls() {
    const preset = document.querySelector<HTMLSelectElement>('#setting-page-preset')!;
    const orientation = document.querySelector<HTMLSelectElement>('#setting-orientation')!;
    preset.value = pagePreset;
    orientation.value = pageOrientation;
    document.querySelector<HTMLElement>('#custom-page-dimensions')!.hidden = pagePreset !== 'custom';
    const width = document.querySelector<HTMLInputElement>('#setting-page-width')!;
    const height = document.querySelector<HTMLInputElement>('#setting-page-height')!;
    width.value = String(pageOrientation === 'landscape' ? pageProfile.height : pageProfile.width);
    height.value = String(pageOrientation === 'landscape' ? pageProfile.width : pageProfile.height);
    for (const [edge, value] of Object.entries(pageProfile.edges)) {
      const field = document.querySelector<HTMLInputElement>(`[data-page-margin="${edge}"]`);
      if (field) field.value = String(value);
    }
    const readToken = (name: string, fallback: unknown) => presentationTokens[name]?.value ?? fallback;
    const fontFamily = String(readToken('font-family', classicStyle.fontFamily));
    const fontPicker = document.querySelector<HTMLSelectElement>('#setting-font-family')!;
    if (!Array.from(fontPicker.options).some((option) => option.value === fontFamily)) {
      fontPicker.add(new Option('Current font', fontFamily, true, true));
    }
    fontPicker.value = fontFamily;
    document.querySelector<HTMLInputElement>('#setting-font-size')!.value = String(readToken('base-font-size', classicStyle.baseFontSize));
    document.querySelector<HTMLInputElement>('#setting-line-height')!.value = String(readToken('line-height', classicStyle.lineHeight));
    const accent = String(readToken('accent-color', classicStyle.accentColor));
    document.querySelector<HTMLInputElement>('#setting-accent-color')!.value = /^#[\da-f]{6}$/i.test(accent) ? accent : classicStyle.accentColor;
  }

  function queuePresentationUpdate(patch: { page?: Record<string, unknown>; tokens?: Record<string, { type: string; value: unknown }> }) {
    const targetId = presentationId;
    if (!targetId) {
      settingsStatus.dataset.state = 'error';
      settingsStatus.textContent = 'No presentation is available to save settings.';
      return;
    }
    settingsStatus.dataset.state = 'saving';
    settingsStatus.textContent = 'Saving document settings…';
    const task = presentationSaveQueue.then(async () => {
      const response = await fetch(`/api/presentation/${encodeURIComponent(targetId)}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ expectedRevision: presentationRevision, ...patch }),
      });
      const result = await response.json() as { ok: boolean; document?: { revision: number }; reason?: string };
      if (!response.ok || !result.document) throw new Error(result.reason ?? 'Could not save document settings.');
      presentationRevision = result.document.revision;
      settingsStatus.dataset.state = 'saved';
      settingsStatus.textContent = 'Document settings saved';
    });
    presentationSaveQueue = task.catch((error) => {
      settingsStatus.dataset.state = 'error';
      settingsStatus.textContent = error instanceof Error ? error.message : 'Could not save document settings.';
    });
  }

  function updatePageSettings() {
    const rawPreset = document.querySelector<HTMLSelectElement>('#setting-page-preset')!.value;
    pagePreset = rawPreset === 'Letter' || rawPreset === 'Legal' || rawPreset === 'custom' ? rawPreset : 'A4';
    pageOrientation = document.querySelector<HTMLSelectElement>('#setting-orientation')!.value === 'landscape' ? 'landscape' : 'portrait';
    const presetDimensions = pagePreset === 'Letter' || pagePreset === 'Legal'
      ? { width: 215.9, height: pagePreset === 'Legal' ? 355.6 : 279.4 }
      : { width: 210, height: 297 };
    const rawWidth = Number(document.querySelector<HTMLInputElement>('#setting-page-width')!.value);
    const rawHeight = Number(document.querySelector<HTMLInputElement>('#setting-page-height')!.value);
    const dimensions = pagePreset === 'custom'
      ? { width: Number.isFinite(rawWidth) ? Math.min(500, Math.max(80, rawWidth)) : 210, height: Number.isFinite(rawHeight) ? Math.min(600, Math.max(100, rawHeight)) : 297 }
      : presetDimensions;
    const edges = Object.fromEntries(['top', 'right', 'bottom', 'left'].map((edge) => {
      const value = Number(document.querySelector<HTMLInputElement>(`[data-page-margin="${edge}"]`)!.value);
      return [edge, Number.isFinite(value) ? Math.min(60, Math.max(0, value)) : 12];
    })) as { top: number; right: number; bottom: number; left: number };
    pageProfile = {
      width: pageOrientation === 'landscape' ? dimensions.height : dimensions.width,
      height: pageOrientation === 'landscape' ? dimensions.width : dimensions.height,
      edges,
    };
    const page: Record<string, unknown> = { preset: pagePreset, orientation: pageOrientation, edges };
    if (pagePreset === 'custom') Object.assign(page, dimensions);
    syncSettingsControls();
    renderPreview();
    queuePresentationUpdate({ page });
  }

  function updateStyleToken(name: string, type: 'string' | 'number' | 'color', value: string | number) {
    const token = { type, value };
    presentationTokens = { ...presentationTokens, [name]: token };
    applyDocumentStyle(presentationTokens);
    renderPreview();
    queuePresentationUpdate({ tokens: { [name]: token } });
  }

  function setStatus(state: 'loading' | 'saving' | 'saved' | 'error' | 'conflict', message: string) {
    saveState.dataset.state = state;
    saveLabel.textContent = message;
  }

  const assetPurposes: Record<string, string> = {
    'profile-photo': 'Profile photo', 'reference-cv': 'Reference CV', certificate: 'Certificate',
    portfolio: 'Portfolio or work sample', other: 'Other reference',
  };

  function renderAssets(assets: WorkspaceAsset[]) {
    assetCount.textContent = String(assets.length);
    assetList.innerHTML = assets.map((asset) => `<li class="asset-item"><span class="asset-file-icon" aria-hidden="true">${asset.contentType.startsWith('image/') ? 'IMG' : asset.name.toLowerCase().endsWith('.pdf') ? 'PDF' : 'DOC'}</span><span class="asset-file-info"><strong title="${escapeHtml(asset.name)}">${escapeHtml(asset.name)}</strong><small>${escapeHtml(assetPurposes[asset.purpose] ?? 'Other reference')} · ${formatBytes(asset.size)}</small></span></li>`).join('');
  }

  function formatBytes(size: number) {
    return size < 1024 * 1024 ? `${Math.max(1, Math.round(size / 1024))} KB` : `${(size / (1024 * 1024)).toFixed(1)} MB`;
  }

  async function loadAssets() {
    const response = await fetch('/api/assets');
    if (!response.ok) throw new Error('Could not load workspace files.');
    renderAssets(await response.json() as WorkspaceAsset[]);
  }

  async function uploadAssets(files: FileList | File[]) {
    if (files.length === 0) return;
    const form = new FormData();
    form.set('purpose', assetPurpose.value);
    for (const file of Array.from(files)) form.append('files', file);
    assetStatus.dataset.state = 'busy';
    assetStatus.textContent = `Uploading ${files.length} ${files.length === 1 ? 'file' : 'files'}…`;
    assetDropzone.disabled = true;
    try {
      const response = await fetch('/api/assets', { method: 'POST', body: form });
      const result = await response.json() as { assets?: WorkspaceAsset[]; error?: string };
      if (!response.ok || !result.assets) throw new Error(result.error ?? 'Upload failed.');
      renderAssets(result.assets);
      const names = result.assets.slice(-files.length).map((asset) => asset.name);
      assetStatus.dataset.state = 'saved';
      assetStatus.textContent = `Saved ${names.length} ${names.length === 1 ? 'file' : 'files'} for your agent.`;
    } catch (error) {
      assetStatus.dataset.state = 'error';
      assetStatus.textContent = error instanceof Error ? error.message : 'Upload failed.';
    } finally {
      assetDropzone.disabled = false;
      assetInput.value = '';
    }
  }

  assetDropzone.addEventListener('click', () => assetInput.click());
  assetInput.addEventListener('change', () => void uploadAssets(assetInput.files ?? []));
  assetDropzone.addEventListener('dragover', (event) => { event.preventDefault(); assetDropzone.dataset.dragging = 'true'; });
  assetDropzone.addEventListener('dragleave', () => { delete assetDropzone.dataset.dragging; });
  assetDropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    delete assetDropzone.dataset.dragging;
    if (event.dataTransfer?.files) void uploadAssets(event.dataTransfer.files);
  });
  void loadAssets().catch((error) => {
    assetStatus.dataset.state = 'error';
    assetStatus.textContent = error instanceof Error ? error.message : 'Could not load workspace files.';
  });

  function experienceIds() {
    if (!cv) return [];
    const all = cv.data.entities.experience ?? {};
    const ordered = new Set(Object.values(cv.data.sections).flatMap((section) => section.nodeOrder ?? []));
    return [...ordered, ...Object.keys(all)].filter((id, index, ids) => all[id] && ids.indexOf(id) === index);
  }

  function field(path: string, value: unknown, placeholder: string, label: string, multiline = false) {
    if (multiline) return `<label class="field"><span>${escapeHtml(label)}</span><textarea rows="${label === 'Summary' ? '5' : '3'}" data-field="${escapeHtml(path)}" placeholder="${escapeHtml(placeholder)}">${escapeHtml(value)}</textarea></label>`;
    return `<label class="field"><span>${escapeHtml(label)}</span><input type="text" data-field="${escapeHtml(path)}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}"></label>`;
  }

  function yearField(path: string, value: unknown, label: string) {
    return `<label class="field"><span>${escapeHtml(label)}</span><input type="number" min="1900" max="2200" step="1" data-field="${escapeHtml(path)}" value="${escapeHtml(value)}" placeholder="YYYY"></label>`;
  }

  function inlineField(path: string, value: unknown, label: string, className = 'cv-inline-field', type = 'text') {
    return `<input type="${type}"${type === 'number' ? ' min="1900" max="2200" step="1"' : ''} class="${className}" data-field="${escapeHtml(path)}" aria-label="${escapeHtml(label)}" value="${escapeHtml(value)}" placeholder="${escapeHtml(label)}">`;
  }

  function inlineText(path: string, value: unknown, label: string, className = 'cv-inline-text') {
    return `<textarea rows="1" class="${className}" data-field="${escapeHtml(path)}" aria-label="${escapeHtml(label)}" placeholder="${escapeHtml(label)}">${escapeHtml(value)}</textarea>`;
  }

  function syncDocumentMode() {
    paper.dataset.mode = documentMode;
    try { localStorage.setItem(modeStorageKey, documentMode); } catch { /* Mode remains active for this session. */ }
    paper.querySelectorAll<HTMLElement>('.paper').forEach((page) => {
      page.dataset.mode = documentMode;
    });
    paper.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((field) => {
      field.readOnly = documentMode === 'preview';
    });
    paper.querySelectorAll<HTMLElement>('.cv-inline-actions, .cv-add-entry, .cv-add-date, .cv-remove-result, .cv-current-toggle').forEach((control) => {
      control.style.display = documentMode === 'preview' ? 'none' : '';
    });
    document.querySelectorAll<HTMLButtonElement>('[data-document-mode]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.documentMode === documentMode));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-document-mode]').forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.dataset.documentMode;
      if (mode !== 'preview' && mode !== 'edit') return;
      documentMode = mode;
      syncDocumentMode();
    });
  });

  function paginatePreviewContent(content: string) {
    printPageStyle.textContent = `@page { size: ${pageProfile.width}mm ${pageProfile.height}mm; margin: 0; }`;
    for (const [name, value] of Object.entries({
      '--page-width-mm': pageProfile.width,
      '--page-height-mm': pageProfile.height,
      '--page-top-mm': pageProfile.edges.top,
      '--page-right-mm': pageProfile.edges.right,
      '--page-bottom-mm': pageProfile.edges.bottom,
      '--page-left-mm': pageProfile.edges.left,
    })) paper.style.setProperty(name, `${value}mm`);

    const measure = document.createElement('div');
    measure.className = 'paper-stack paper-measure';
    measure.dataset.mode = documentMode;
    Object.assign(measure.style, { position: 'fixed', inset: '0 auto auto -10000px', visibility: 'hidden', width: `${pageProfile.width}mm` });
    for (const [name, value] of Object.entries({
      '--page-width-mm': pageProfile.width,
      '--page-height-mm': pageProfile.height,
      '--page-top-mm': pageProfile.edges.top,
      '--page-right-mm': pageProfile.edges.right,
      '--page-bottom-mm': pageProfile.edges.bottom,
      '--page-left-mm': pageProfile.edges.left,
    })) measure.style.setProperty(name, `${value}mm`);
    measure.style.setProperty('--paper-zoom', '1');
    document.body.append(measure);

    const source = document.createElement('div');
    source.innerHTML = content;
    const pages: HTMLElement[] = [];
    const makePage = () => {
      const page = document.createElement('article');
      page.className = 'paper';
      page.dataset.mode = documentMode;
      page.dataset.pageNumber = String(pages.length + 1);
      page.setAttribute('aria-label', `Page ${pages.length + 1}`);
      const contentRoot = document.createElement('div');
      contentRoot.className = 'cv-content';
      page.append(contentRoot);
      measure.append(page);
      pages.push(page);
      return page;
    };
    const sizeTextareas = (pageToSize: HTMLElement) => pageToSize.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((textarea) => {
      textarea.style.height = 'auto';
      textarea.style.height = `${textarea.scrollHeight}px`;
    });
    let page = makePage();
    let contentRoot = page.querySelector<HTMLElement>('.cv-content')!;
    const header = source.querySelector('.cv-header');
    if (header) contentRoot.append(header.cloneNode(true));
    for (const sourceSection of Array.from(source.querySelectorAll<HTMLElement>('.cv-section'))) {
      const heading = sourceSection.querySelector(':scope > h2');
      const nodes = Array.from(sourceSection.children).filter((node) => node !== heading);
      const items: Array<{ node: Element; skill?: boolean }> = [];
      for (const node of nodes) {
        if (sourceSection.dataset.cvSection?.includes('skills') && node.matches('p')) {
          for (const skill of Array.from(node.children)) items.push({ node: skill, skill: true });
        } else items.push({ node });
      }
      let section: HTMLElement | null = null;
      const startSection = (targetPage: HTMLElement) => {
        section = sourceSection.cloneNode(false) as HTMLElement;
        if (heading) section.append(heading.cloneNode(true));
        targetPage.querySelector<HTMLElement>('.cv-content')!.append(section);
        return section;
      };
      for (const item of items) {
        if (!section || section.parentElement !== contentRoot) startSection(page);
        const hadSectionItems = Boolean(section!.querySelector('.cv-entry, [data-node-id], .cv-skill'));
        let wrapper: HTMLElement | null = null;
        if (item.skill) {
          wrapper = section!.querySelector(':scope > p') ?? document.createElement('p');
          if (!wrapper.parentElement) section!.append(wrapper);
          wrapper.append(item.node.cloneNode(true));
        } else section!.append(item.node.cloneNode(true));
        sizeTextareas(page);
        if (page.scrollHeight > page.clientHeight && (hadSectionItems || page.querySelectorAll('.cv-section').length > 1 || Boolean(page.querySelector('.cv-header')))) {
          if (item.skill && wrapper) {
            wrapper.lastElementChild?.remove();
            if (!wrapper.children.length) wrapper.remove();
          }
          else section!.lastElementChild?.remove();
          if (!section!.children.length || (heading && section!.children.length === 1)) section!.remove();
          page = makePage();
          contentRoot = page.querySelector<HTMLElement>('.cv-content')!;
          section = startSection(page);
          if (item.skill) {
            const nextWrapper = document.createElement('p');
            nextWrapper.append(item.node.cloneNode(true));
            section.append(nextWrapper);
          } else section.append(item.node.cloneNode(true));
          sizeTextareas(page);
        }
      }
    }
    const pinnedPageCount = Math.max(0, ...orderedComments().map(([, thread]) => placementOf(thread)?.page ?? 0));
    while (pages.length < pinnedPageCount) makePage();
    measure.remove();
    paper.replaceChildren(...pages);
    paper.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((textarea) => {
      textarea.style.height = 'auto';
      textarea.style.height = `${textarea.scrollHeight}px`;
    });
    syncDocumentMode();
  }

  function renderEditor() {
    if (!cv) return;
    const sameEditorCv = editor.dataset.groupsReady === 'true' && editor.dataset.cvId === cv.id;
    const groupStateKey = `${disclosureStoragePrefix}editor-groups.${cv.id}`;
    let openGroups = sameEditorCv
      ? new Set(Array.from(editor.querySelectorAll<HTMLDetailsElement>('details.editor-group[open]'), (group) => group.id))
      : new Set<string>();
    if (!sameEditorCv) {
      let hasSavedGroupState = false;
      try {
        const saved = localStorage.getItem(groupStateKey);
        if (saved !== null) {
          const parsed: unknown = JSON.parse(saved);
          if (Array.isArray(parsed)) {
            openGroups = new Set(parsed.filter((id): id is string => typeof id === 'string'));
            hasSavedGroupState = true;
          }
        }
      } catch { /* Use the default open profile group. */ }
      if (!hasSavedGroupState) openGroups.add('edit-identity');
    }
    const identity = cv.data.identity;
    const experiences = experienceIds().map((id) => {
      const item = cv!.data.entities.experience![id]!;
      return `<details class="editor-group experience-editor" id="edit-${escapeHtml(id)}">
        <summary class="group-heading"><span class="group-heading-title">${escapeHtml(item.role.title || 'Experience')}</span><span class="group-heading-meta">${escapeHtml(item.organization.name)}</span></summary>
        <div class="group-body"><button class="text-button danger-text group-remove" type="button" data-remove-experience="${escapeHtml(id)}">Remove experience</button>
        ${field(`experience.${id}.role.title`, item.role.title, 'Role title', 'Role')}
        ${field(`experience.${id}.organization.name`, item.organization.name, 'Organization', 'Organization')}
        ${yearField(`experience.${id}.period.start.year`, item.period.start.year, 'Start year')}
        ${item.period.ongoing ? '<label class="field field-checkbox"><span>Current role</span><input type="checkbox" data-ongoing-for="' + escapeHtml(id) + '" checked></label>' : `${yearField(`experience.${id}.period.end.year`, item.period.end?.year ?? '', 'End year')}<label class="field field-checkbox"><span>Current role</span><input type="checkbox" data-ongoing-for="${escapeHtml(id)}"></label>`}
        ${field(`experience.${id}.summary`, item.summary ?? '', 'A short description of your work', 'Description', true)}
        ${item.bulletOrder.map((bulletId, index) => `${field(`experience.${id}.bullets.${bulletId}.text`, item.bullets[bulletId]?.text ?? '', 'What changed because of your work?', `Result ${index + 1}`, true)}<button type="button" class="text-button danger-text" data-remove-bullet="experience.${escapeHtml(id)}.${escapeHtml(bulletId)}">Remove result</button>`).join('')}
        <button class="text-button" type="button" data-add-bullet="${escapeHtml(id)}">${iconMarkup('plus')} Add result</button>
        </div>
      </details>`;
    }).join('');
    const education = Object.values(cv.data.entities.education ?? {}).map((item) => `<details class="editor-group" id="edit-education-${escapeHtml(item.id)}">
      <summary class="group-heading"><span class="group-heading-title">${escapeHtml(item.program.name || 'Education')}</span><span class="group-heading-meta">${escapeHtml(item.institution.name)}</span></summary>
      <div class="group-body"><button class="text-button danger-text group-remove" type="button" data-remove-entry="education.${escapeHtml(item.id)}">Remove education</button>
      ${field(`education.${item.id}.program.name`, item.program.name, 'Program or course', 'Program')}
      ${field(`education.${item.id}.program.degree`, item.program.degree ?? '', 'Degree or qualification', 'Degree')}
      ${field(`education.${item.id}.institution.name`, item.institution.name, 'School or institution', 'Institution')}
      ${yearField(`education.${item.id}.period.start.year`, item.period.start.year, 'Start year')}
      ${yearField(`education.${item.id}.period.end.year`, item.period.end?.year ?? '', 'End year')}
      ${(item.details.length ? item.details : ['']).map((detail, index) => field(`education.${item.id}.details.${index}`, detail, 'Additional detail', `Detail ${index + 1}`, true)).join('')}
      </div>
    </details>`).join('');
    const projects = Object.values(cv.data.entities.projects ?? {}).map((item) => `<details class="editor-group" id="edit-project-${escapeHtml(item.id)}">
      <summary class="group-heading"><span class="group-heading-title">${escapeHtml(item.name || 'Project')}</span><span class="group-heading-meta">${escapeHtml(item.role?.title ?? 'Project')}</span></summary>
      <div class="group-body"><button class="text-button danger-text group-remove" type="button" data-remove-entry="projects.${escapeHtml(item.id)}">Remove project</button>
      ${field(`projects.${item.id}.name`, item.name, 'Project name', 'Name')}
      ${item.role ? field(`projects.${item.id}.role.title`, item.role.title, 'Project role', 'Role') : `<button type="button" class="text-button" data-add-project-role="${escapeHtml(item.id)}">${iconMarkup('plus')} Add role</button>`}
      ${field(`projects.${item.id}.summary`, item.summary ?? '', 'What did you build?', 'Description', true)}
      ${(item.bulletOrder ?? []).map((bulletId, index) => `${field(`projects.${item.id}.bullets.${bulletId}.text`, item.bullets?.[bulletId]?.text ?? '', 'Project result', `Result ${index + 1}`, true)}<button type="button" class="text-button danger-text" data-remove-bullet="projects.${escapeHtml(item.id)}.${escapeHtml(bulletId)}">Remove result</button>`).join('')}
      <button type="button" class="text-button" data-add-project-bullet="${escapeHtml(item.id)}">${iconMarkup('plus')} Add result</button>
      ${item.period ? `${yearField(`projects.${item.id}.period.start.year`, item.period.start.year, 'Start year')}${item.period.ongoing ? '' : yearField(`projects.${item.id}.period.end.year`, item.period.end?.year ?? '', 'End year')}<label class="field field-checkbox"><span>Current project</span><input type="checkbox" data-ongoing-project-for="${escapeHtml(item.id)}"${item.period.ongoing ? ' checked' : ''}></label>` : `<button type="button" class="text-button" data-add-project-dates="${escapeHtml(item.id)}">${iconMarkup('plus')} Add dates</button>`}
      </div>
    </details>`).join('');
    const skills = Object.values(cv.data.entities.skills ?? {}).map((item) => `<details class="editor-group" id="edit-skill-${escapeHtml(item.id)}">
      <summary class="group-heading"><span class="group-heading-title">${escapeHtml(item.name || 'Skill')}</span><span class="group-heading-meta">${escapeHtml(item.category ?? 'Skill')}</span></summary>
      <div class="group-body"><button class="text-button danger-text group-remove" type="button" data-remove-entry="skills.${escapeHtml(item.id)}">Remove skill</button>
      ${field(`skills.${item.id}.name`, item.name, 'Skill', 'Name')}
      ${field(`skills.${item.id}.category`, item.category ?? '', 'e.g. Languages', 'Category')}
      </div>
    </details>`).join('');
    const customSections = cv.data.sectionOrder.flatMap((sectionId) => {
      const section = cv!.data.sections[sectionId];
      if (!section || section.type !== 'custom') return [];
      const entries = (section.nodeOrder ?? []).flatMap((entryId) => {
        const item = cv!.data.entities.custom?.[entryId];
        if (!item) return [];
        const dataFields = Object.entries(item.data).map(([key, value]) => {
          const pathKey = isEditableCustomFieldKey(key) ? key : '';
          if (!pathKey || (value !== null && typeof value === 'object')) return `<div class="custom-value"><span>${escapeHtml(key)}</span><pre>${escapeHtml(JSON.stringify(value, null, 2))}</pre><small>Structured values are edited by the agent.</small></div>`;
          const label = key.replaceAll('_', ' ').replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
          return `<div class="custom-field-row"><label class="field custom-key-field"><span>Field key</span><input type="text" value="${escapeHtml(key)}" data-custom-field-key="${escapeHtml(item.id)}.${escapeHtml(key)}" aria-label="Field key"></label>${field(`custom.${item.id}.data.${key}`, value ?? '', label, label)}<button type="button" class="text-button danger-text" data-remove-custom-field="${escapeHtml(item.id)}.${escapeHtml(key)}" aria-label="Remove ${escapeHtml(label)}">Remove field</button></div>`;
        }).join('');
        return [`<details class="editor-group" id="edit-custom-entry-${escapeHtml(item.id)}">
          <summary class="group-heading"><span class="group-heading-title">${escapeHtml(item.label || 'Custom entry')}</span><span class="group-heading-meta">Custom entry</span></summary>
          <div class="group-body"><button class="text-button danger-text group-remove" type="button" data-remove-custom-entry="${escapeHtml(item.id)}">Remove entry</button>
          ${field(`custom.${item.id}.label`, item.label, 'Entry label', 'Label')}
          ${dataFields}<button type="button" class="text-button" data-add-custom-field="${escapeHtml(item.id)}">${iconMarkup('plus')} Add field</button>
          </div>
        </details>`];
      }).join('');
      const heading = `<header class="editor-section-heading custom-section-heading"><label><span class="sr-only">Section title</span><input type="text" data-field="sections.${escapeHtml(section.id)}.title" value="${escapeHtml(section.title)}" aria-label="Section title"></label><button type="button" class="text-button danger-text" data-remove-custom-section="${escapeHtml(section.id)}">Remove section</button></header>`;
      return [`<section class="editor-section" id="edit-custom-section-${escapeHtml(section.id)}">${heading}<div class="editor-section-body"><div>${entries || '<p class="custom-empty">This section has no entries yet.</p>'}</div><button type="button" class="add-entry" data-add-custom-entry="${escapeHtml(section.id)}">${iconMarkup('plus')} Add entry</button></div></section>`];
    }).join('');
    const email = identity.contact.find((item) => item.kind === 'email')?.value ?? '';
    const editorSection = (title: string, meta: string, body: string, id = '') => `<section class="editor-section"${id ? ` id="${id}"` : ''}><header class="editor-section-heading"><h3>${escapeHtml(title)}</h3><span>${escapeHtml(meta)}</span></header><div class="editor-section-body">${body}</div></section>`;
    editor.innerHTML = `${editorSection('Profile', '4 fields', `
      ${field('identity.name.display', identity.name.display, 'Your name', 'Name')}
      ${field('identity.headline', identity.headline ?? '', 'Role or professional focus', 'Headline')}
      ${field('contact.email', email, 'name@example.com', 'Email')}
      ${field('identity.summary', identity.summary ?? '', 'A concise introduction to your work', 'Summary', true)}
    `, 'edit-identity')}
      ${editorSection('Experience', `${experienceIds().length} entries`, `<div id="edit-experience">${experiences}</div><button type="button" class="add-entry" id="add-experience-inline">${iconMarkup('plus')} Add experience</button>`)}
      ${editorSection('Education', `${Object.keys(cv.data.entities.education ?? {}).length} entries`, `${education}<button type="button" class="add-entry" data-add-entry="education">${iconMarkup('plus')} Add education</button>`)}
      ${editorSection('Projects', `${Object.keys(cv.data.entities.projects ?? {}).length} entries`, `${projects}<button type="button" class="add-entry" data-add-entry="projects">${iconMarkup('plus')} Add project</button>`)}
      ${editorSection('Skills', `${Object.keys(cv.data.entities.skills ?? {}).length} entries`, `${skills}<button type="button" class="add-entry" data-add-entry="skills">${iconMarkup('plus')} Add skill</button>`)}
      ${customSections}
      <button type="button" class="add-entry add-custom-section" id="add-custom-section">${iconMarkup('plus')} Add custom section</button>`;
    editor.dataset.groupsReady = 'true';
    editor.dataset.cvId = cv.id;
    editor.querySelectorAll<HTMLDetailsElement>('details.editor-group').forEach((group) => {
      group.open = openGroups.has(group.id);
      group.addEventListener('toggle', () => {
        const visibleGroups = Array.from(editor.querySelectorAll<HTMLDetailsElement>('details.editor-group[open]'), (item) => item.id);
        try { localStorage.setItem(groupStateKey, JSON.stringify(visibleGroups)); } catch { /* Accordions still work for this session. */ }
      });
    });
  }

  function renderPreview() {
    if (!cv) return;
    const identity = cv.data.identity;
    const contacts = identity.contact.find((entry) => entry.kind === 'email')?.value ?? identity.contact[0]?.value ?? '';
    const experienceEntries = experienceIds().map((id) => {
      const item = cv!.data.entities.experience![id]!;
      const ongoing = Boolean(item.period.ongoing);
      const bullets = item.bulletOrder.map((bulletId, index) => item.bullets[bulletId]
        ? `<li data-node-id="${escapeHtml(bulletId)}" data-node-type="bullet">${inlineText(`experience.${id}.bullets.${bulletId}.text`, item.bullets[bulletId]?.text, `Result ${index + 1}`, 'cv-inline-text cv-inline-result')}<button type="button" class="cv-remove-result danger-text" data-remove-bullet="experience.${escapeHtml(id)}.${escapeHtml(bulletId)}" aria-label="Remove result ${index + 1}">Remove</button></li>`
        : '').join('');
      return `<div class="cv-entry" data-node-id="${escapeHtml(id)}" data-node-type="experience">
        <div class="cv-entry-head"><strong>${inlineField(`experience.${id}.role.title`, item.role.title, 'Role title', 'cv-inline-title')}</strong><div class="cv-date-range">${inlineField(`experience.${id}.period.start.year`, item.period.start.year, 'Start year', 'cv-inline-year', 'number')}<span>–</span>${ongoing ? '<span class="cv-present">Present</span>' : inlineField(`experience.${id}.period.end.year`, item.period.end?.year ?? '', 'End year', 'cv-inline-year', 'number')}</div></div>
        <p class="cv-organization">${inlineField(`experience.${id}.organization.name`, item.organization.name, 'Organization', 'cv-inline-organization')}</p>
        <label class="cv-current-toggle"><input type="checkbox" data-ongoing-for="${escapeHtml(id)}"${ongoing ? ' checked' : ''}> Current role</label>
        ${inlineText(`experience.${id}.summary`, item.summary ?? '', 'Role description', 'cv-inline-text cv-inline-description')}
        ${bullets ? `<ul>${bullets}</ul>` : ''}
        <div class="cv-inline-actions"><button type="button" data-add-bullet="${escapeHtml(id)}">${iconMarkup('plus')} Add result</button><button type="button" class="danger-text" data-remove-experience="${escapeHtml(id)}">Remove experience</button></div>
      </div>`;
    }).join('');
    const experiences = `<section class="cv-section" data-cv-section-type="experience" data-cv-section="${escapeHtml(sectionIdFor('experience'))}"><h2>Experience</h2>${experienceEntries || '<p class="cv-empty-note">Add a role to show your experience.</p>'}<button type="button" class="cv-add-entry" data-add-experience>${iconMarkup('plus')} Add experience</button></section>`;
    const educationRows = Object.values(cv.data.entities.education ?? {}).map((item) => `<div class="cv-entry" data-node-id="${escapeHtml(item.id)}" data-node-type="education">
      <div class="cv-entry-head"><strong>${inlineField(`education.${item.id}.program.name`, item.program.name, 'Program', 'cv-inline-title')}</strong><div class="cv-date-range">${inlineField(`education.${item.id}.period.start.year`, item.period.start.year, 'Start year', 'cv-inline-year', 'number')}<span>–</span>${inlineField(`education.${item.id}.period.end.year`, item.period.end?.year ?? '', 'End year', 'cv-inline-year', 'number')}</div></div>
      <p class="cv-organization">${inlineField(`education.${item.id}.institution.name`, item.institution.name, 'Institution', 'cv-inline-organization')}<span class="cv-degree-separator"> · </span>${inlineField(`education.${item.id}.program.degree`, item.program.degree ?? '', 'Degree', 'cv-inline-organization')}</p>
      ${(item.details.length ? item.details : ['']).map((detail, index) => inlineText(`education.${item.id}.details.${index}`, detail, `Education detail ${index + 1}`, 'cv-inline-text cv-inline-description')).join('')}
      <div class="cv-inline-actions"><button type="button" class="danger-text" data-remove-entry="education.${escapeHtml(item.id)}">Remove education</button></div>
    </div>`).join('');
    const education = `<section class="cv-section" data-cv-section-type="education" data-cv-section="${escapeHtml(sectionIdFor('education'))}"><h2>Education</h2>${educationRows || '<p class="cv-empty-note">Add a course or qualification.</p>'}<button type="button" class="cv-add-entry" data-add-entry="education">${iconMarkup('plus')} Add education</button></section>`;
    const projectRows = Object.values(cv.data.entities.projects ?? {}).map((item) => `<div class="cv-entry" data-node-id="${escapeHtml(item.id)}" data-node-type="project">
      ${inlineField(`projects.${item.id}.name`, item.name, 'Project name', 'cv-inline-title')}
      ${item.role ? inlineField(`projects.${item.id}.role.title`, item.role.title, 'Project role', 'cv-inline-organization') : `<button type="button" class="cv-add-date" data-add-project-role="${escapeHtml(item.id)}">${iconMarkup('plus')} Add role</button>`}
      ${inlineText(`projects.${item.id}.summary`, item.summary ?? '', 'Project description', 'cv-inline-text cv-inline-description')}
      ${(item.bulletOrder ?? []).length ? `<ul>${(item.bulletOrder ?? []).map((bulletId, index) => `<li data-node-id="${escapeHtml(bulletId)}" data-node-type="bullet">${inlineText(`projects.${item.id}.bullets.${bulletId}.text`, item.bullets?.[bulletId]?.text ?? '', `Project result ${index + 1}`, 'cv-inline-text cv-inline-result')}<button type="button" class="cv-remove-result danger-text" data-remove-bullet="projects.${escapeHtml(item.id)}.${escapeHtml(bulletId)}" aria-label="Remove project result ${index + 1}">Remove</button></li>`).join('')}</ul>` : ''}
      <div class="cv-inline-actions"><button type="button" data-add-project-bullet="${escapeHtml(item.id)}">${iconMarkup('plus')} Add result</button></div>
      ${item.period ? `<div class="cv-date-range cv-project-dates">${inlineField(`projects.${item.id}.period.start.year`, item.period.start.year, 'Start year', 'cv-inline-year', 'number')}<span>–</span>${item.period.ongoing ? '<span class="cv-present">Present</span>' : inlineField(`projects.${item.id}.period.end.year`, item.period.end?.year ?? '', 'End year', 'cv-inline-year', 'number')}<label class="cv-current-toggle"><input type="checkbox" data-ongoing-project-for="${escapeHtml(item.id)}"${item.period.ongoing ? ' checked' : ''}> Current</label></div>` : `<button type="button" class="cv-add-date" data-add-project-dates="${escapeHtml(item.id)}">${iconMarkup('plus')} Add dates</button>`}
      <div class="cv-inline-actions"><button type="button" class="danger-text" data-remove-entry="projects.${escapeHtml(item.id)}">Remove project</button></div>
    </div>`).join('');
    const projects = `<section class="cv-section" data-cv-section-type="projects" data-cv-section="${escapeHtml(sectionIdFor('projects'))}"><h2>Projects</h2>${projectRows || '<p class="cv-empty-note">Add a project to feature here.</p>'}<button type="button" class="cv-add-entry" data-add-entry="projects">${iconMarkup('plus')} Add project</button></section>`;
    const summary = identity.summary?.trim();
    const skillRows = Object.values(cv.data.entities.skills ?? {});
    const skills = `<section class="cv-section" data-cv-section-type="skills" data-cv-section="${escapeHtml(sectionIdFor('skills'))}"><h2>Skills</h2><p>${skillRows.map((skill) => `<span class="cv-skill" data-node-id="${escapeHtml(skill.id)}" data-node-type="skill">${inlineField(`skills.${skill.id}.name`, skill.name, 'Skill', 'cv-skill-input')}<span class="cv-skill-separator">·</span>${inlineField(`skills.${skill.id}.category`, skill.category ?? '', 'Category', 'cv-skill-category')}</span>`).join(' ')}</p><button type="button" class="cv-add-entry" data-add-entry="skills">${iconMarkup('plus')} Add skill</button></section>`;
    const customSections = cv.data.sectionOrder.flatMap((sectionId) => {
      const section = cv!.data.sections[sectionId];
      if (!section || section.type !== 'custom' || !section.visible) return [];
      const entries = (section.nodeOrder ?? []).flatMap((entryId) => {
        const item = cv!.data.entities.custom?.[entryId];
        if (!item) return [];
        const dataFields = Object.entries(item.data).map(([key, value]) => {
          const pathKey = isEditableCustomFieldKey(key) ? key : '';
          const text = value === null || value === undefined ? '' : typeof value === 'object' ? JSON.stringify(value) : String(value);
          const label = key.replaceAll('_', ' ').replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
          const editable = pathKey && (value === null || typeof value !== 'object');
          return editable ? `<p class="cv-custom-value"><span class="cv-custom-label">${escapeHtml(label)}:</span> ${inlineText(`custom.${item.id}.data.${key}`, text, label, 'cv-inline-text cv-inline-description')}</p>` : `<p class="cv-custom-value"><span class="cv-custom-label">${escapeHtml(label)}:</span> ${escapeHtml(text)}</p>`;
        }).join('');
        return [`<article class="cv-entry cv-custom-entry" data-node-id="${escapeHtml(item.id)}" data-node-type="customEntity"><h3>${inlineField(`custom.${item.id}.label`, item.label, 'Entry label', 'cv-inline-title')}</h3>${dataFields}<div class="cv-inline-actions"><button type="button" class="danger-text" data-remove-custom-entry="${escapeHtml(item.id)}">Remove entry</button></div></article>`];
      }).join('');
      return [`<section class="cv-section" data-cv-section-type="custom" data-cv-section="${escapeHtml(section.id)}"><h2>${inlineField(`sections.${section.id}.title`, section.title, 'Section title', 'cv-custom-section-title')}</h2>${entries || '<p class="cv-empty-note">Add an entry to this section.</p>'}<button type="button" class="cv-add-entry" data-add-custom-entry="${escapeHtml(section.id)}">${iconMarkup('plus')} Add entry</button></section>`];
    }).join('');
    const content = `<header class="cv-header">
      <input class="cv-name" aria-label="Name" data-field="identity.name.display" value="${escapeHtml(identity.name.display)}" placeholder="Your name">
      <input class="cv-headline" aria-label="Headline" data-field="identity.headline" value="${escapeHtml(identity.headline ?? '')}" placeholder="Professional headline">
      <input class="cv-contact" aria-label="Email" data-field="contact.email" value="${escapeHtml(contacts)}" placeholder="Email or contact details">
    </header>
      <section class="cv-section cv-summary" data-cv-section-type="summary" data-cv-section="${escapeHtml(sectionIdFor('summary'))}"><h2>Profile</h2>${inlineText('identity.summary', summary ?? '', 'Profile summary', 'cv-inline-text cv-summary-text')}</section>
      ${experiences}
      ${education}${projects}${skills}${customSections}`;
    paginatePreviewContent(content);
    document.querySelector('#preview-name')!.textContent = identity.name.display || 'Untitled CV';
    renderCommentMarkers();
  }

  function renderSections() {
    if (!cv) return;
    const sections = cv.data.sectionOrder.map((id) => cv!.data.sections[id]).filter((item) => item?.visible);
    sectionList.innerHTML = sections.map((section, index) => {
      const firstExperience = section.type === 'experience' ? experienceIds()[0] : undefined;
      const firstEducation = Object.keys(cv!.data.entities.education ?? {})[0];
      const firstProject = Object.keys(cv!.data.entities.projects ?? {})[0];
      const firstSkill = Object.keys(cv!.data.entities.skills ?? {})[0];
      const firstCustom = section.type === 'custom' ? section.nodeOrder?.[0] : undefined;
      const editorTarget = firstExperience ? `edit-${firstExperience}` : section.type === 'education' && firstEducation ? `edit-education-${firstEducation}` : section.type === 'projects' && firstProject ? `edit-project-${firstProject}` : section.type === 'skills' && firstSkill ? `edit-skill-${firstSkill}` : section.type === 'custom' ? (firstCustom ? `edit-custom-entry-${firstCustom}` : `edit-custom-section-${section.id}`) : section.type === 'summary' ? 'edit-identity' : '';
      const count = section.type === 'experience' ? experienceIds().length
        : section.type === 'education' ? Object.keys(cv!.data.entities.education ?? {}).length
        : section.type === 'projects' ? Object.keys(cv!.data.entities.projects ?? {}).length
        : section.type === 'skills' ? Object.keys(cv!.data.entities.skills ?? {}).length
        : section.type === 'custom' ? (section.nodeOrder?.length ?? 0)
        : 0;
      return `<button type="button" class="section-link" data-section="${escapeHtml(section.id)}"${editorTarget ? ` data-editor-target="${editorTarget}"` : ''}><span class="section-glyph" aria-hidden="true">${iconMarkup(sectionIcons[section.type] ?? 'file', 'icon section-icon')}</span><span class="section-title">${escapeHtml(section.title)}</span>${count > 0 ? `<span class="section-count">${count}</span>` : ''}<span class="section-check" aria-hidden="true">${iconMarkup('check', 'icon section-check-icon')}</span></button>`;
    }).join('');
  }

  function render() {
    if (!cv) return;
    renderEditor();
    renderPreview();
    renderSections();
  }

  function orderedComments(): Array<[string, StoredThread]> {
    if (!commentsDocument) return [];
    return commentsDocument.data.threadOrder.flatMap((id) => {
      const thread = commentsDocument?.data.threads[id];
      return thread ? [[id, thread] as [string, StoredThread]] : [];
    });
  }

  function placementOf(thread: StoredThread): { page: number; x: number; y: number; element: string; contextText?: string } | null {
    const saved = thread.target.extensions?.['seevee.placement'];
    if (saved && typeof saved === 'object') {
      const value = saved as Record<string, unknown>;
      if (typeof value.x === 'number' && typeof value.y === 'number') {
        return {
          page: typeof value.page === 'number' ? value.page : 1,
          x: value.x,
          y: value.y,
          element: typeof value.element === 'string' ? value.element : 'Page area',
          ...(typeof value.contextText === 'string' && value.contextText ? { contextText: value.contextText } : {}),
        };
      }
    }
    const region = thread.target.selectors.find((selector) => selector.type === 'PageRegionSelector');
    if (!region || typeof region.x !== 'number' || typeof region.y !== 'number') return null;
    return { page: typeof region.page === 'number' ? region.page : 1, x: region.x, y: region.y, element: 'Page area' };
  }

  function renderComments() {
    const threads = orderedComments();
    commentCount.textContent = String(threads.length);
    commentList.innerHTML = threads.length ? threads.map(([id, thread]) => {
      const first = thread.messages[thread.messageOrder.at(-1) ?? ''];
      const placement = placementOf(thread);
      const category = (thread.category ?? 'general').replaceAll('_', ' ');
      const priority = thread.priority ?? 'normal';
      const status = thread.status ?? 'open';
      const number = (commentsDocument?.data.threadOrder.indexOf(id) ?? 0) + 1;
      const location = placement ? `Page ${placement.page} · ${placement.element}` : 'CV comment';
      return `<article class="comment-card" data-comment-status="${escapeHtml(status)}">
        <div class="comment-card-heading"><span class="comment-number">${String(number).padStart(2, '0')}</span><span class="comment-category">${escapeHtml(category)}</span><span class="comment-priority" data-priority="${escapeHtml(priority)}">${escapeHtml(priority)}</span><span class="comment-status" data-status="${escapeHtml(status)}">${escapeHtml(status.replaceAll('_', ' '))}</span></div>
        <p class="comment-body">${escapeHtml(first?.body ?? 'Comment')}</p>
        <div class="comment-location" title="${escapeHtml(placement?.contextText ?? location)}">${iconMarkup('cornerDownRight', 'icon comment-location-icon')}${escapeHtml(location)}${first?.author?.display ? ` · ${escapeHtml(first.author.display)}` : ''}</div>
        <div class="comment-card-actions"><button type="button" class="comment-jump" data-comment-jump="${escapeHtml(id)}">Show pin</button><button type="button" data-comment-edit="${escapeHtml(id)}">Edit</button><button type="button" data-comment-move="${escapeHtml(id)}" aria-label="Move comment pin ${number}">Move</button><button type="button" class="danger-text" data-comment-delete="${escapeHtml(id)}" aria-label="Delete comment ${number}">Delete</button></div>
      </article>`;
    }).join('') : '<p class="quiet-message">No comments yet. Choose “Place comment” to pin one to the page.</p>';
    renderCommentMarkers();
  }

  function renderCommentMarkers() {
    paper.querySelectorAll('.comment-marker').forEach((marker) => marker.remove());
    for (const [id, thread] of orderedComments()) {
      const placement = placementOf(thread);
      if (!placement) continue;
      const page = paper.querySelector<HTMLElement>(`.paper[data-page-number="${placement.page}"]`);
      if (!page) continue;
      const marker = document.createElement('button');
      marker.type = 'button';
      marker.className = 'comment-marker';
      marker.dataset.commentJump = id;
      marker.style.left = `${placement.x * 100}%`;
      marker.style.top = `${placement.y * 100}%`;
      marker.textContent = String((commentsDocument?.data.threadOrder.indexOf(id) ?? 0) + 1);
      marker.setAttribute('aria-label', `Comment ${marker.textContent} at ${placement.element}`);
      marker.title = `${thread.messages[thread.messageOrder.at(-1) ?? '']?.body ?? 'Comment'} · drag or right-click for actions`;
      page.append(marker);
    }
  }

  function selectorForElement(target: Element): Record<string, unknown> | null {
    const fieldTarget = target.closest<HTMLElement>('[data-field]');
    const fieldPath = fieldTarget?.dataset.field;
    const sectionId = target.closest<HTMLElement>('[data-cv-section]')?.dataset.cvSection;
    if (fieldPath && cv) {
      const bits = fieldPath.split('.');
      let nodeId = cv.data.identity.id;
      let nodeType = 'person';
      let pointer = `/${bits.slice(1).map((bit) => bit.replace(/~/g, '~0').replace(/\//g, '~1')).join('/')}`;
      if (bits[0] === 'contact') pointer = '/contact/0/value';
      if (bits[0] === 'experience') {
        nodeId = bits[1]!;
        nodeType = 'experience';
        pointer = `/${bits.slice(2).map((bit) => bit.replace(/~/g, '~0').replace(/\//g, '~1')).join('/')}`;
      } else if (bits[0] === 'education' || bits[0] === 'projects' || bits[0] === 'skills') {
        nodeId = bits[1]!;
        nodeType = bits[0] === 'projects' ? 'project' : bits[0].slice(0, -1);
        pointer = `/${bits.slice(2).map((bit) => bit.replace(/~/g, '~0').replace(/\//g, '~1')).join('/')}`;
      }
      return { type: 'FieldSelector', nodeId, nodeType, field: pointer };
    }
    const node = target.closest<HTMLElement>('[data-node-id][data-node-type]');
    if (node?.dataset.nodeId && node.dataset.nodeType) return { type: 'NodeSelector', nodeId: node.dataset.nodeId, nodeType: node.dataset.nodeType };
    if (sectionId) return { type: 'SectionSelector', sectionId };
    return null;
  }

  function describePlacement(target: Element) {
    const field = target.closest<HTMLElement>('[data-field]');
    const section = target.closest<HTMLElement>('[data-cv-section]');
    const node = target.closest<HTMLElement>('[data-node-id][data-node-type]');
    const fieldPath = field?.dataset.field;
    const element = field?.getAttribute('aria-label')
      ?? (fieldPath ? fieldPathLabel(fieldPath) : undefined)
      ?? (node ? `${node.dataset.nodeType === 'bullet' ? 'Result' : node.dataset.nodeType ?? 'CV item'} · ${node.querySelector('strong')?.textContent?.trim() ?? node.textContent?.trim()}` : undefined)
      ?? section?.querySelector('h2')?.textContent?.trim()
      ?? 'Page area';
    const textContext = target.closest<HTMLElement>('li, p, h1, h2, strong, span');
    const contextSource = field
      ? (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement ? field.value : field.textContent)
      : textContext?.textContent ?? node?.textContent ?? section?.textContent ?? '';
    const contextText = contextSource?.replace(/\s+/g, ' ').trim().slice(0, 280) || undefined;
    return { element, contextText, fieldPath, selector: selectorForElement(target) };
  }

  function closeContextMenu() {
    contextMenu.hidden = true;
    contextMenu.replaceChildren();
    contextTarget = null;
  }

  function openContextMenu(target: Element, clientX: number, clientY: number) {
    const marker = target.closest<HTMLElement>('.comment-marker');
    const commentId = marker?.dataset.commentJump;
    const pageTarget = marker
      ? document.elementsFromPoint(clientX, clientY).find((element) => element !== marker && !element.closest('.comment-marker') && paper.contains(element)) ?? paper
      : target;
    const field = pageTarget.closest<HTMLElement>('[data-field]');
    const entry = pageTarget.closest<HTMLElement>('[data-node-id][data-node-type]');
    const section = pageTarget.closest<HTMLElement>('[data-cv-section]');
    const described = describePlacement(pageTarget);
    const actions: Array<{ id: string; label: string; danger?: boolean }> = [
      { id: 'comment', label: commentId ? 'Add another comment here' : 'Add a comment here' },
    ];
    if (field?.dataset.field) actions.push({ id: 'edit-field', label: `Edit ${fieldPathLabel(field.dataset.field)} in content panel` });
    else if (entry?.dataset.nodeId) actions.push({ id: 'edit-entry', label: 'Edit this entry in content panel' });
    const sectionType = cv?.data.sections[section?.dataset.cvSection ?? '']?.type;
    const experience = pageTarget.closest<HTMLElement>('[data-node-type="experience"]');
    if (documentMode === 'edit') {
      if (experience?.dataset.nodeId) actions.push({ id: 'add-result', label: 'Add result to this experience' });
      if (sectionType === 'experience' && !entry) actions.push({ id: 'add-experience', label: 'Add experience' });
      if (sectionType === 'education') actions.push({ id: 'add-education', label: 'Add education' });
      if (sectionType === 'projects') actions.push({ id: 'add-project', label: 'Add project' });
      if (sectionType === 'skills') actions.push({ id: 'add-skill', label: 'Add skill' });
    }
    if (commentId) {
      actions.push({ id: 'edit-comment', label: 'Edit this comment' });
      actions.push({ id: 'move-comment', label: 'Move pin to a new spot' });
      actions.push({ id: 'delete-comment', label: 'Delete this comment', danger: true });
    }
    contextTarget = { target: pageTarget, ...locationOnPage(clientX, clientY, pageTarget), ...(commentId ? { commentId } : {}), described };
    const commentThread = commentId ? commentsDocument?.data.threads[commentId] : undefined;
    const commentNumber = commentId ? (commentsDocument?.data.threadOrder.indexOf(commentId) ?? 0) + 1 : 0;
    const menuHeading = commentId ? `Comment ${commentNumber}` : described.element;
    const menuSummary = commentThread?.messages[commentThread.messageOrder.at(-1) ?? '']?.body;
    contextMenu.innerHTML = `<div class="context-menu-heading">${escapeHtml(menuHeading)}</div>${menuSummary ? `<p class="context-menu-summary">${escapeHtml(menuSummary)}</p>` : ''}<div class="context-menu-items">${actions.map((action) => `<button type="button" role="menuitem" data-context-action="${action.id}"${action.danger ? ' class="danger-text"' : ''}><span class="context-menu-label">${escapeHtml(action.label)}</span>${iconMarkup(action.danger ? 'trash2' : 'arrowRight', 'icon context-menu-icon')}</button>`).join('')}</div>`;
    contextMenu.hidden = false;
    const left = Math.max(8, Math.min(clientX, window.innerWidth - contextMenu.offsetWidth - 8));
    const top = Math.max(8, Math.min(clientY, window.innerHeight - contextMenu.offsetHeight - 8));
    contextMenu.style.left = `${left}px`;
    contextMenu.style.top = `${top}px`;
  }

  function placeCommentAt(target: Element, x: number, y: number) {
    if (!cv) return;
    const described = describePlacement(target);
    pendingPlacement = {
      page: Number(target.closest<HTMLElement>('.paper')?.dataset.pageNumber ?? 1), x, y, element: described.element,
      ...(described.contextText ? { contextText: described.contextText } : {}),
      ...(described.fieldPath ? { fieldPath: described.fieldPath } : {}),
      ...(described.selector?.nodeId ? { nodeId: String(described.selector.nodeId), nodeType: String(described.selector.nodeType), pointer: String(described.selector.field ?? '') } : {}),
      ...(described.selector?.sectionId ? { sectionId: String(described.selector.sectionId) } : {}),
    };
    placingComment = false;
    movingCommentId = null;
    commentButton.setAttribute('aria-pressed', 'false');
    commentButton.setAttribute('aria-label', 'Place a comment on the CV');
    commentButton.title = 'Choose a place on the CV for a comment';
    paper.classList.remove('is-placing-comment');
    editingThreadId = null;
    document.querySelector('#comment-title')!.textContent = 'Leave a comment';
    document.querySelector('#comment-save')!.textContent = 'Save comment';
    commentLabel.textContent = `Page 1 · ${described.element}${described.contextText ? ` · “${described.contextText}”` : ''}`;
    commentBody.value = '';
    commentDialog.showModal();
    commentBody.focus();
  }

  function openEditorGroup(id: string) {
    const group = editor.querySelector<HTMLDetailsElement>(`details.editor-group#${CSS.escape(id)}`);
    if (group) group.open = true;
    return group;
  }

  function focusEditorFor(target: Element, fieldPath?: string) {
    const node = target.closest<HTMLElement>('[data-node-id][data-node-type]');
    const bulletOwner = node?.dataset.nodeType === 'bullet'
      ? target.closest<HTMLElement>('[data-node-type="experience"], [data-node-type="project"]')
      : null;
    const inferredPath = bulletOwner?.dataset.nodeType === 'project'
      ? `projects.${bulletOwner.dataset.nodeId}.bullets.${node?.dataset.nodeId}.text`
      : bulletOwner
        ? `experience.${bulletOwner.dataset.nodeId}.bullets.${node?.dataset.nodeId}.text`
        : fieldPath;
    const control = inferredPath
      ? editor.querySelector<HTMLElement>(`[data-field="${CSS.escape(inferredPath)}"]`)
      : null;
    const nodeId = node?.dataset.nodeId;
    const groupId = inferredPath?.startsWith('experience.') ? `edit-${inferredPath.split('.')[1]}`
      : inferredPath?.startsWith('education.') ? `edit-education-${inferredPath.split('.')[1]}`
        : inferredPath?.startsWith('projects.') ? `edit-project-${inferredPath.split('.')[1]}`
          : inferredPath?.startsWith('skills.') ? `edit-skill-${inferredPath.split('.')[1]}`
            : node?.dataset.nodeType === 'education' ? `edit-education-${nodeId}`
              : node?.dataset.nodeType === 'project' ? `edit-project-${nodeId}`
                : node?.dataset.nodeType === 'skill' ? `edit-skill-${nodeId}`
                  : nodeId ? `edit-${nodeId}` : 'edit-identity';
    const group = editor.querySelector<HTMLElement>(`#${CSS.escape(groupId)}`);
    if (group instanceof HTMLDetailsElement) group.open = true;
    (control ?? group)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    control?.focus({ preventScroll: true });
  }

  function fieldPathLabel(path: string) {
    const parts = path.split('.');
    const labels: Record<string, string> = {
      display: 'Name', headline: 'Headline', summary: 'Summary', email: 'Email',
      title: 'Role title', text: 'Result text', name: 'Name', degree: 'Degree',
      category: 'Category',
    };
    const label = labels[parts.at(-1) ?? ''] ?? parts.at(-1) ?? 'CV field';
    const group = parts[0] === 'experience' ? 'Experience'
      : parts[0] === 'education' ? 'Education'
        : parts[0] === 'projects' ? 'Project'
          : parts[0] === 'skills' ? 'Skill'
            : '';
    return group ? `${group} · ${label}` : label;
  }

  async function beginCommentPlacement() {
    if (!cv || !commentButton) return;
    if (editCount !== savedCount || saving) await flushSave();
    if (editCount !== savedCount || saveState.dataset.state === 'error' || saveState.dataset.state === 'conflict') return;
    placingComment = !placingComment;
    movingCommentId = null;
    commentButton.setAttribute('aria-pressed', String(placingComment));
    commentButton.setAttribute('aria-label', placingComment ? 'Click the CV page to add a comment' : 'Place a comment on the CV');
    commentButton.title = placingComment ? 'Click the CV page to add a comment' : 'Choose a place on the CV for a comment';
    paper.classList.toggle('is-placing-comment', placingComment);
  }

  async function beginCommentMove(threadId: string) {
    if (!cv) return;
    if (editCount !== savedCount || saving) await flushSave();
    if (editCount !== savedCount || saveState.dataset.state === 'error' || saveState.dataset.state === 'conflict') return;
    movingCommentId = threadId;
    placingComment = true;
    commentButton.setAttribute('aria-pressed', 'true');
    commentButton.setAttribute('aria-label', 'Click the CV page to move the selected comment pin');
    commentButton.title = 'Click the CV page to move the selected comment pin';
    paper.classList.add('is-placing-comment');
  }

  function finishCommentMove() {
    movingCommentId = null;
    placingComment = false;
    commentButton.setAttribute('aria-pressed', 'false');
    commentButton.setAttribute('aria-label', 'Place a comment on the CV');
    commentButton.title = 'Choose a place on the CV for a comment';
    paper.classList.remove('is-placing-comment');
  }

  function captureCommentPlacement(event: MouseEvent) {
    if (!placingComment || !cv) return;
    event.preventDefault();
    event.stopPropagation();
    const clicked = event.target instanceof Element ? event.target : paper;
    const element = clicked.closest('.comment-marker')
      ? document.elementsFromPoint(event.clientX, event.clientY).find((item) => !item.closest('.comment-marker') && paper.contains(item)) ?? paper
      : clicked;
    const point = locationOnPage(event.clientX, event.clientY, clicked);
    if (movingCommentId) {
      if (clicked.closest<HTMLElement>('.comment-marker')?.dataset.commentJump === movingCommentId) return;
      const described = describePlacement(element);
      const threadId = movingCommentId;
      void moveComment(threadId, point.x, point.y, {
        element: described.element,
        contextText: described.contextText ?? null,
        fieldPath: described.fieldPath ?? null,
        selector: described.selector,
      }, point.page).then(finishCommentMove).catch((error) => setStatus('error', error instanceof Error ? error.message : 'Could not move comment.'));
      return;
    }
    placeCommentAt(element, point.x, point.y);
  }

  async function saveComment(body: string) {
    if (!cv || !body.trim()) return;
    if (editingThreadId) {
      const response = await fetch(`/api/comments/${encodeURIComponent(cv.id)}`, {
        method: 'PUT', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ expectedRevision: commentRevision, threadId: editingThreadId, body: body.trim() }),
      });
      const result = await response.json() as { ok: boolean; document?: CommentsDoc; reason?: string };
      if (!response.ok || !result.document) throw new Error(result.reason ?? 'Could not update comment.');
      commentsDocument = result.document;
      commentRevision = result.document.revision;
      editingThreadId = null;
      renderComments();
      return;
    }
    if (!pendingPlacement) return;
    const now = new Date().toISOString();
    const threadId = `comment_${crypto.randomUUID().replace(/-/g, '')}`;
    const messageId = `message_${crypto.randomUUID().replace(/-/g, '')}`;
    const page = pendingPlacement;
    const selectors: Array<Record<string, unknown>> = [];
    if (page.fieldPath && page.nodeId && page.nodeType && page.pointer) selectors.push({ type: 'FieldSelector', nodeId: page.nodeId, nodeType: page.nodeType, field: page.pointer });
    else if (page.sectionId) selectors.push({ type: 'SectionSelector', sectionId: page.sectionId });
    else if (page.nodeId && page.nodeType) selectors.push({ type: 'NodeSelector', nodeId: page.nodeId, nodeType: page.nodeType });
    selectors.push({
      type: 'PageRegionSelector', page: page.page, x: page.x, y: page.y, width: 0.015, height: 0.015,
      renderContext: { cvRevision: cv.revision, presentationRevision: presentationContext.revision, templateVersionId: presentationContext.versionId },
    });
    const thread = {
      id: threadId, category: 'general', priority: 'normal', status: 'open',
      target: {
        source: { resource: 'cv', resourceId: cv.id, revisionAtCreation: cv.revision },
        selectors,
        extensions: { 'seevee.placement': { page: page.page, x: page.x, y: page.y, element: page.element, contextText: page.contextText ?? null, fieldPath: page.fieldPath ?? null } },
      },
      messageOrder: [messageId],
      messages: { [messageId]: { id: messageId, author: { kind: 'user', display: 'You' }, body: body.trim(), createdAt: now } },
      agentWork: { state: 'pending', claimedByRunId: null, changeSetIds: [] },
      resolution: null, createdAt: now, updatedAt: now,
    };
    const response = await fetch(`/api/comments/${encodeURIComponent(cv.id)}`, {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ expectedRevision: commentRevision, thread }),
    });
    const result = await response.json() as { ok: boolean; document?: CommentsDoc; reason?: string };
    if (!response.ok || !result.document) throw new Error(result.reason ?? 'Could not save comment.');
    commentsDocument = result.document;
    commentRevision = result.document.revision;
    pendingPlacement = null;
    renderComments();
  }

  function editComment(threadId: string) {
    const thread = commentsDocument?.data.threads[threadId];
    if (!thread) return;
    editingThreadId = threadId;
    pendingPlacement = null;
    const message = thread.messages[thread.messageOrder.at(-1) ?? ''];
    document.querySelector('#comment-title')!.textContent = 'Edit comment';
    document.querySelector('#comment-save')!.textContent = 'Save changes';
    const placement = placementOf(thread);
    commentLabel.textContent = placement ? `Page ${placement.page} · ${placement.element}` : 'CV comment';
    commentBody.value = message?.body ?? '';
    commentDialog.showModal();
    commentBody.focus();
  }

  async function deleteComment(threadId: string) {
    if (!cv) return;
    const response = await fetch(`/api/comments/${encodeURIComponent(cv.id)}`, {
      method: 'DELETE', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ expectedRevision: commentRevision, threadId }),
    });
    const result = await response.json() as { ok: boolean; document?: CommentsDoc; reason?: string };
    if (!response.ok || !result.document) throw new Error(result.reason ?? 'Could not delete comment.');
    commentsDocument = result.document;
    commentRevision = result.document.revision;
    renderComments();
