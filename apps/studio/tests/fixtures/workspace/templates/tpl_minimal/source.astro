---
// Classic — single-column, ATS-friendly resume template.
//
// The dashboard passes `cv`, `presentation`, and `profile` via Astro.props.
// We accept unknown and validate with the canonical schema so the
// template never asserts `any` on untrusted input.

import { z } from 'zod';

import {
  Page,
  Section,
  Item,
  Field,
  getSection,
  getItem,
  deriveCv,
} from '@seevee/template-sdk';
import type {
  CvReadModel,
  CvSection,
  CvItem,
  ItemId,
  SectionId,
  PageProfile,
  PresentationReadModel,
} from '@seevee/template-sdk';
import {
  cvDocumentSchema,
  presentationDocumentSchema,
  pageProfileSchema,
} from '@seevee/schema';
import type { CvDocument, PresentationDocument } from '@seevee/schema';

const propsSchema = z.object({
  cv: cvDocumentSchema,
  presentation: presentationDocumentSchema.optional(),
  profile: pageProfileSchema,
});

type Props = z.infer<typeof propsSchema>;
type CvEntitySection = CvSection & { readonly nodeOrder?: readonly string[] };

const props = propsSchema.parse(Astro.props) as Props;
const cv: CvReadModel = deriveCv(props.cv as CvDocument);
const presentation = props.presentation as PresentationDocument | undefined;
const profile: PageProfile = props.profile as PageProfile;

// Canonical ATS-friendly section order.
const SECTION_IDS = [
  'summary',
  'experience',
  'education',
  'skills',
  'projects',
] as const;

type CanonicalSectionId = (typeof SECTION_IDS)[number];

function visibleSection(id: CanonicalSectionId): CvEntitySection | null {
  const section = getSection(cv, id as SectionId);
  if (section === null) return null;
  if (!section.visible) return null;
  return section as CvEntitySection;
}

const sections = SECTION_IDS
  .map((id) => ({ id, section: visibleSection(id) }))
  .filter(
    (entry): entry is { id: CanonicalSectionId; section: CvEntitySection } =>
      entry.section !== null,
  );

const customSections = props.cv.data.sectionOrder
  .map((id) => props.cv.data.sections[id])
  .filter((section) => section?.type === 'custom' && section.visible);

const identity = props.cv.data.identity;
const contact = identity.contact;

// Token defaults (declared in template.json — keep these in sync).
const tokens = presentation?.data.tokens;
const accentToken = tokens?.['accent-color'];
const fontToken = tokens?.['font-family'];
const sizeToken = tokens?.['base-font-size'];
const lineHeightToken = tokens?.['line-height'];
const accentColor = accentToken?.type === 'color' ? accentToken.value : '#1f2937';
const fontFamily = fontToken?.type === 'string'
  ? fontToken.value
  : 'Inter, system-ui, sans-serif';
const baseFontSize = sizeToken?.type === 'number' ? sizeToken.value : 11;
const lineHeight = lineHeightToken?.type === 'number' ? lineHeightToken.value : 1.4;

function safeItem(itemId: ItemId, sectionId: SectionId): CvItem | null {
  return getItem(cv, itemId, sectionId);
}
---

<Page profile={profile} presentation={presentation as PresentationReadModel | undefined}>
  <header class="classic-identity" data-seevee-identity="root">
    <h1 class="classic-name">{identity.name.display}</h1>
    {contact.length > 0 && (
      <ul class="classic-contact">
        {contact.map((channel) => (
          <li class="classic-contact-item">{channel.value}</li>
        ))}
      </ul>
    )}
  </header>

  {sections.map(({ id, section }) => (
    <Section cv={cv} sectionId={id as SectionId}>
      <h2 class="classic-section-title">{section.title}</h2>

      {id === 'summary' && (
        <p class="classic-summary">
          <Field
            cv={cv}
            itemId={(section.nodeOrder?.[0] ?? identity.id) as ItemId}
            sectionId={id as SectionId}
            fieldPath="/text"
            fallback=""
          />
        </p>
      )}

      {id === 'experience' && (
        <ol class="classic-experience">
          {(section.nodeOrder ?? []).map((entityId) => {
            const item = safeItem(entityId as ItemId, id as SectionId);
            if (item === null) return null;
            return (
              <Item cv={cv} itemId={entityId as ItemId} sectionId={id as SectionId}>
                <div class="classic-role-head">
                  <span class="classic-role-title">
                    <Field
                      cv={cv}
                      itemId={entityId as ItemId}
                      sectionId={id as SectionId}
                      fieldPath="/role/title"
                      fallback=""
                    />
                  </span>
                  <span class="classic-role-employer">
                    <Field
                      cv={cv}
                      itemId={entityId as ItemId}
                      sectionId={id as SectionId}
                      fieldPath="/organization/name"
                      fallback=""
                    />
                  </span>
                </div>
                <div class="classic-role-period">
                  <Field
                    cv={cv}
                    itemId={entityId as ItemId}
                    sectionId={id as SectionId}
                    fieldPath="/period/start/year"
                    fallback=""
                  />
                  {' – '}
                  <Field
                    cv={cv}
                    itemId={entityId as ItemId}
                    sectionId={id as SectionId}
                    fieldPath="/period/end/year"
                    fallback=""
                  />
                </div>
                <p class="classic-role-summary">
                  <Field
                    cv={cv}
                    itemId={entityId as ItemId}
                    sectionId={id as SectionId}
                    fieldPath="/summary"
                    fallback=""
                  />
                </p>
              </Item>
            );
          })}
        </ol>
      )}

      {id === 'education' && (
        <ol class="classic-education">
          {(section.nodeOrder ?? []).map((entityId) => (
            <Item cv={cv} itemId={entityId as ItemId} sectionId={id as SectionId}>
              <div class="classic-edu-head">
                <span class="classic-edu-institution">
                  <Field
                    cv={cv}
                    itemId={entityId as ItemId}
                    sectionId={id as SectionId}
                    fieldPath="/institution/name"
                    fallback=""
                  />
                </span>
                <span class="classic-edu-degree">
                  <Field
                    cv={cv}
                    itemId={entityId as ItemId}
                    sectionId={id as SectionId}
                    fieldPath="/degree/title"
                    fallback=""
                  />
                </span>
              </div>
              <div class="classic-edu-period">
                <Field
                  cv={cv}
                  itemId={entityId as ItemId}
                  sectionId={id as SectionId}
                  fieldPath="/period/start/year"
                  fallback=""
                />
                {' – '}
                <Field
                  cv={cv}
                  itemId={entityId as ItemId}
                  sectionId={id as SectionId}
                  fieldPath="/period/end/year"
                  fallback=""
                />
              </div>
            </Item>
          ))}
        </ol>
      )}

      {id === 'skills' && (
        <ul class="classic-skills">
          {(section.nodeOrder ?? []).map((entityId) => (
            <Item cv={cv} itemId={entityId as ItemId} sectionId={id as SectionId}>
              <span class="classic-skill-name">
                <Field
                  cv={cv}
                  itemId={entityId as ItemId}
                  sectionId={id as SectionId}
                  fieldPath="/name"
                  fallback=""
                />
              </span>
            </Item>
          ))}
        </ul>
      )}

      {id === 'projects' && (
        <ol class="classic-projects">
          {(section.nodeOrder ?? []).map((entityId) => (
            <Item cv={cv} itemId={entityId as ItemId} sectionId={id as SectionId}>
              <h3 class="classic-project-name">
                <Field
                  cv={cv}
                  itemId={entityId as ItemId}
                  sectionId={id as SectionId}
                  fieldPath="/name"
                  fallback=""
                />
              </h3>
              <p class="classic-project-summary">
                <Field
                  cv={cv}
                  itemId={entityId as ItemId}
                  sectionId={id as SectionId}
                  fieldPath="/summary"
                  fallback=""
                />
              </p>
            </Item>
          ))}
        </ol>
      )}
    </Section>
  ))}

  {customSections.map((section) => (
    <Section cv={cv} sectionId={section.id as SectionId}>
      <h2 class="classic-section-title">{section.title}</h2>
      <div class="classic-custom-entries">
        {(section.nodeOrder ?? []).map((entityId) => {
          const item = safeItem(entityId as ItemId, section.id as SectionId);
          if (!item || item.type !== 'customEntity') return null;
          return (
            <Item cv={cv} itemId={entityId as ItemId} sectionId={section.id as SectionId}>
              <article class="classic-custom-entry">
                <h3><Field cv={cv} itemId={entityId as ItemId} sectionId={section.id as SectionId} fieldPath="/label" fallback={item.label} /></h3>
                <dl>
                  {Object.entries(item.data).map(([key, value]) => (
                    <div class="classic-custom-field">
                      <dt>{key.replaceAll('_', ' ').replaceAll('-', ' ')}</dt>
                      <dd><Field cv={cv} itemId={entityId as ItemId} sectionId={section.id as SectionId} fieldPath={`/data/${key.replaceAll('~', '~0').replaceAll('/', '~1')}`} fallback={typeof value === 'string' ? value : JSON.stringify(value) ?? ''} /></dd>
                    </div>
                  ))}
                </dl>
              </article>
            </Item>
          );
        })}
      </div>
    </Section>
  ))}
</Page>

<style
  define:vars={{
    accentColor,
    fontFamily,
    baseFontSize: `${String(baseFontSize)}pt`,
    lineHeight: String(lineHeight),
  }}
>
  /* Classic layout with a restrained serif accent in the identity header. */
  .classic-identity {
    margin-bottom: 6mm;
    border-bottom: 0.5mm solid #743d5b;
    padding-bottom: 3.5mm;
  }
  .classic-name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: calc(var(--baseFontSize) * 2);
    line-height: var(--lineHeight);
    letter-spacing: -0.035em;
    margin: 0 0 1mm 0;
    color: #743d5b;
  }
  .classic-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4mm;
    font-family: var(--fontFamily);
    font-size: var(--baseFontSize);
    line-height: var(--lineHeight);
  }
  .classic-section-title {
    font-family: var(--fontFamily);
    font-size: calc(var(--baseFontSize) * 1.2);
    line-height: var(--lineHeight);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 4mm 0 2mm 0;
    color: var(--accentColor);
    border-bottom: 0.2mm solid var(--accentColor);
  }
  .classic-summary,
  .classic-role-summary,
  .classic-project-summary {
    font-family: var(--fontFamily);
    font-size: var(--baseFontSize);
    line-height: var(--lineHeight);
    margin: 1mm 0 3mm 0;
  }
  .classic-experience > [data-seevee-item],
  .classic-education > [data-seevee-item],
  .classic-projects > [data-seevee-item] {
    margin-bottom: 3mm;
  }
  .classic-custom-entry { margin-bottom: 3mm; }
  .classic-custom-entry h3 { margin: 0 0 1mm; font-size: 1em; }
  .classic-custom-entry dl { margin: 0; }
  .classic-custom-field { display: flex; gap: 2mm; margin: 0.5mm 0; }
  .classic-custom-field dt { font-weight: 600; }
  .classic-custom-field dd { margin: 0; }
  .classic-role-head,
  .classic-edu-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--fontFamily);
    font-size: var(--baseFontSize);
    line-height: var(--lineHeight);
    font-weight: 600;
  }
  .classic-role-period,
  .classic-edu-period {
    font-family: var(--fontFamily);
    font-size: calc(var(--baseFontSize) - 1);
    line-height: var(--lineHeight);
    color: #4b5563;
    margin-bottom: 1mm;
  }
  .classic-skills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2mm 4mm;
    font-family: var(--fontFamily);
    font-size: var(--baseFontSize);
    line-height: var(--lineHeight);
  }
  .classic-skills li::after {
    content: '•';
    margin-left: 4mm;
    color: #9ca3af;
  }
  .classic-skills li:last-child::after {
    content: '';
    margin: 0;
  }
</style>
